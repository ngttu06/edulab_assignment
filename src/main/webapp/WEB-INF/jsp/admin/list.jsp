<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<div class="admin-page-heading"><div><span class="admin-eyebrow"><c:out value="${resource.group()}"/></span><h1><c:out value="${resource.title()}"/> <span class="admin-count">${listing.total()}</span></h1><p>Quản lý tập trung, tìm kiếm và cập nhật dữ liệu toàn hệ thống.</p></div><c:if test="${not resource.readOnly()}"><a class="btn btn-primary" href="${pageContext.request.contextPath}/admin/${resource.key()}/new">＋ Thêm mới</a></c:if></div>
<section class="admin-panel">
    <form class="admin-filter" method="get"><div class="admin-search"><ui:icon name="search"/><label class="visually-hidden" for="adminSearch">Tìm kiếm</label><input id="adminSearch" name="search" value="<c:out value='${search}'/>" maxlength="160" placeholder="Tìm kiếm trong danh sách…"></div>
        <label class="visually-hidden" for="adminState">Trạng thái</label><select id="adminState" name="state" class="form-select"><option value="all">Tất cả trạng thái</option><option value="active" ${state == 'active' ? 'selected' : ''}>Đang hoạt động</option><option value="inactive" ${state == 'inactive' ? 'selected' : ''}>Đã khóa / lưu trữ</option></select>
        <label class="visually-hidden" for="adminSort">Sắp xếp</label><select id="adminSort" name="sort" class="form-select"><option value="newest">Mới nhất</option><option value="oldest" ${sort == 'oldest' ? 'selected' : ''}>Cũ nhất</option><option value="name" ${sort == 'name' ? 'selected' : ''}>Theo tên / nội dung</option></select><button class="btn btn-outline-secondary">Lọc dữ liệu</button><c:if test="${not empty search or state != 'all'}"><a class="admin-clear" href="${pageContext.request.contextPath}/admin/${resource.key()}">Xóa lọc</a></c:if>
    </form>
    <div class="admin-table-wrap" tabindex="0" role="region" aria-label="Danh sách ${resource.title()}"><table class="admin-table"><thead><tr><th>ID</th><c:forEach var="column" items="${resource.columns()}"><th><c:out value="${column.label()}"/></th></c:forEach><c:if test="${not empty resource.state()}"><th>Trạng thái</th></c:if><th class="admin-actions-col">Thao tác</th></tr></thead><tbody>
    <c:forEach var="item" items="${listing.items()}"><tr><td class="admin-id">#${item.id}</td><c:forEach var="column" items="${resource.columns()}" varStatus="loop"><td><c:choose><c:when test="${loop.first}"><a class="admin-cell-title" href="${pageContext.request.contextPath}/admin/${resource.key()}/${item.id}"><c:out value="${item[column.key()]}" default="—"/></a></c:when><c:otherwise><span class="admin-cell-text"><c:out value="${item[column.key()]}" default="—"/></span></c:otherwise></c:choose></td></c:forEach>
    <c:if test="${not empty resource.state()}"><td><span class="admin-badge ${item.inactive ? 'muted' : 'success'}"><c:out value="${item.stateLabel}"/></span></td></c:if>
    <td><div class="admin-row-actions"><a href="${pageContext.request.contextPath}/admin/${resource.key()}/${item.id}">Xem</a><c:if test="${not resource.readOnly()}"><c:choose><c:when test="${item.inactive and resource.key() != 'assignments' and resource.key() != 'files'}"><button type="button" data-admin-action="restore" data-resource="${resource.key()}" data-id="${item.id}">Khôi phục</button></c:when><c:when test="${not item.inactive}"><a href="${pageContext.request.contextPath}/admin/${resource.key()}/${item.id}/edit">Sửa</a><button type="button" class="admin-danger" data-admin-action="delete" data-resource="${resource.key()}" data-id="${item.id}">${empty resource.state() ? 'Xóa' : resource.key() == 'files' ? 'Chặn tệp' : 'Ngừng / lưu trữ'}</button></c:when></c:choose></c:if></div></td></tr></c:forEach>
    <c:if test="${empty listing.items()}"><tr><td colspan="12"><div class="admin-empty"><ui:icon name="search"/><h2>Chưa có kết quả</h2><p>Thử thay đổi từ khóa, bộ lọc hoặc thêm bản ghi mới.</p></div></td></tr></c:if>
    </tbody></table></div>
    <jsp:include page="/WEB-INF/jsp/admin/pagination.jsp"/>
</section>
<p class="admin-footnote"><c:choose><c:when test="${resource.readOnly()}">Dữ liệu chỉ đọc để bảo toàn lịch sử và trạng thái kiểm tra an toàn.</c:when><c:when test="${empty resource.state()}">Chỉ xóa được khi không có dữ liệu liên quan. Các ràng buộc được kiểm tra trên máy chủ.</c:when><c:otherwise>Ngừng hoạt động / lưu trữ giữ nguyên lịch sử học tập và các dữ liệu liên quan.</c:otherwise></c:choose></p>