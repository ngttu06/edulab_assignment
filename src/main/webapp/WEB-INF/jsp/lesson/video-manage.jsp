<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<span class="eyebrow">KHÔNG GIAN GIÁO VIÊN</span><h1 class="h3">Video bài học</h1>
<p class="text-muted">Mỗi bài có một video chính. Giáo viên chỉ quản lý bài được admin phân công; học sinh xem video của bài đã xuất bản.</p>
<c:if test="${not playerAvailable}"><div class="alert alert-warning">PlayerJS chưa được cài tại <code><c:out value="${playerPath}"/></code>. Admin cần cài bản miễn phí từ PlayerJS Builder, bật HLS và API Events. YouTube vẫn sử dụng được.</div></c:if>
<p class="small text-muted">Domain m3u8 được phép: <c:choose><c:when test="${empty videoHosts}">chưa cấu hình (EDULAB_VIDEO_ALLOWED_HOSTS)</c:when><c:otherwise><c:out value="${videoHosts}"/></c:otherwise></c:choose>. Manifest, segment và khóa HLS cần HTTPS/CORS phù hợp; không hỗ trợ livestream không có thời lượng cố định.</p>
<p id="videoManageNotice" role="status" aria-live="polite"></p>
<div class="row g-3">
<section class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">Thêm / thay video</h2>
<form id="videoManageForm" data-player-path="<c:out value='${playerPath}'/>" data-player-available="${playerAvailable}">
<label for="videoLesson" class="form-label">Bài học</label><select id="videoLesson" class="form-select mb-3" required><option value="">Chọn bài học</option><c:forEach var="item" items="${lessons}"><option value="${item.id}"><c:out value="${item.subject_name}"/> ${item.grade_level} · <c:out value="${item.title}"/></option></c:forEach></select>
<label for="videoProvider" class="form-label">Nguồn video</label><select id="videoProvider" class="form-select mb-3"><option value="YOUTUBE">YouTube</option><option value="PLAYERJS">PlayerJS miễn phí — m3u8</option></select>
<label for="videoUrl" class="form-label">Link HTTPS</label><input id="videoUrl" class="form-control mb-3" type="url" maxlength="2048" required placeholder="https://www.youtube.com/watch?v=…">
<div class="row g-2"><div class="col-sm-6"><label for="videoDuration" class="form-label">Thời lượng chính xác (giây)</label><input id="videoDuration" class="form-control" type="number" min="1" max="21600" required></div><div class="col-sm-6"><label for="videoThreshold" class="form-label">Ngưỡng hoàn thành (%)</label><input id="videoThreshold" class="form-control" type="number" min="80" max="100" value="95" required></div></div>
<p class="small text-muted mt-2">Xem thử để kiểm tra thời lượng. Mỗi lần lưu tạo phiên bản video mới, bắt đầu lại tiến độ bài và giữ lịch sử các đoạn đã xem của video cũ.</p>
<div class="d-flex flex-wrap gap-2"><button class="btn btn-primary" type="submit">Lưu video</button><button id="previewVideo" type="button" class="btn btn-outline-primary">Xem thử</button><button id="removeVideo" type="button" class="btn btn-outline-danger" disabled>Gỡ video</button></div>
</form></div></div></section>
<section class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">Xem thử trước khi lưu</h2><div id="videoPreview" class="video-preview"><div id="previewPlayer"></div></div><p id="previewNotice" class="small text-muted mt-2" role="status">Chọn bài và nhập link video để xem thử. Không lưu tiến độ trong chế độ này.</p></div></div></section>
</div>
<section class="card mt-4"><div class="card-body"><h2 class="h5">Bài học và phân công</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Bài học</th><th>Video</th><th>Giáo viên quản lý</th></tr></thead><tbody>
<c:forEach var="item" items="${lessons}"><tr><td><c:out value="${item.title}"/><br><span class="small text-muted"><c:out value="${item.course_title}"/> · <c:out value="${item.status}"/></span></td><td><c:choose><c:when test="${not empty item.provider}"><c:out value="${item.provider}"/> · v${item.revision}<c:if test="${item.status == 'PUBLISHED'}"><br><a href="${pageContext.request.contextPath}/lessons/${item.id}/video">Mở video</a></c:if></c:when><c:otherwise>Chưa có video</c:otherwise></c:choose></td><td>
<c:choose><c:when test="${pageContext.request.isUserInRole('ADMIN')}"><form class="videoTeacherForm" data-lesson="${item.id}"><label class="visually-hidden" for="videoTeacher${item.id}">Giáo viên cho <c:out value="${item.title}"/></label><select id="videoTeacher${item.id}" class="form-select form-select-sm"><option value="">Chỉ admin</option><c:forEach var="teacher" items="${teachers}"><option value="${teacher.id}" ${item.video_teacher_id == teacher.id ? 'selected' : ''}><c:out value="${teacher.full_name}"/> (<c:out value="${teacher.username}"/>)</option></c:forEach></select><button type="submit" class="btn btn-sm btn-outline-primary mt-2">Lưu phân công</button></form></c:when><c:otherwise><c:out value="${item.teacher_name}"/></c:otherwise></c:choose>
</td></tr></c:forEach></tbody></table></div><c:if test="${empty lessons}"><p class="text-muted">Chưa có bài được phân công. Hãy liên hệ admin.</p></c:if></div></section>
<script src="${pageContext.request.contextPath}/js/video-player.js" defer></script>
<script src="${pageContext.request.contextPath}/js/video-manage.js" defer></script>