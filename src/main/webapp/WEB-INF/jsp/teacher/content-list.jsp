<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="nav.jspf" %>
<div class="teacher-heading"><div><h1>${kind == 'lessons' ? 'Bài học của tôi' : 'Quiz & đề kiểm tra của tôi'}</h1><p>Chọn nội dung để xem chi tiết hoặc chỉnh sửa. Nội dung đã xóa vẫn giữ lịch sử học tập.</p></div><div class="teacher-actions"><a class="btn btn-primary" href="${pageContext.request.contextPath}/teacher/${kind}/new">${kind == 'quizzes' ? 'Tạo quiz' : 'Thêm mới'}</a><c:if test="${kind == 'quizzes'}"><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/teacher/quizzes/new?mode=TEST">Tạo đề kiểm tra</a><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/teacher/quizzes/import">Nhập CSV / PDF / Word</a></c:if></div></div>
<div class="row g-2 mb-3"><div class="col-md-8"><label for="teacherContentSearch" class="visually-hidden">Tìm nội dung</label><input id="teacherContentSearch" type="search" class="form-control" placeholder="Tìm theo tiêu đề" maxlength="200"></div><div class="col-md-4"><label for="teacherContentFilter" class="visually-hidden">Lọc trạng thái</label><select id="teacherContentFilter" class="form-select"><option value="all">Tất cả trạng thái</option><option value="draft">Bản nháp</option><option value="published">Đã xuất bản</option><option value="archived">Đã lưu trữ / xóa</option></select></div></div>
<c:set var="items" value="${kind == 'lessons' ? data.lessons : data.quizzes}"/>
<div class="list-group" id="teacherContentItems"><c:forEach var="item" items="${items}"><a class="list-group-item list-group-item-action" data-title="<c:out value='${item.title}'/>" data-status="${not empty item.deleted_at or item.status == 'ARCHIVED' ? 'archived' : (item.status == 'DRAFT' or (kind == 'quizzes' and not item.published) ? 'draft' : 'published')}" href="${pageContext.request.contextPath}/teacher/${kind}/${item.id}"><strong><c:out value="${item.title}"/></strong><br><small><c:choose><c:when test="${not empty item.deleted_at}">Đã xóa · lịch sử được giữ lại</c:when><c:when test="${kind == 'lessons'}">${item.status == 'PUBLISHED' ? 'Đã xuất bản' : item.status == 'ARCHIVED' ? 'Đã lưu trữ' : 'Bản nháp'}</c:when><c:otherwise>${item.published ? 'Đã xuất bản' : 'Bản nháp'}</c:otherwise></c:choose></small></a></c:forEach></div>
<c:if test="${empty items}"><p>Chưa có nội dung. Chọn Thêm mới để bắt đầu.</p></c:if>
<p id="teacherContentEmpty" class="d-none mt-3" role="status">Không có nội dung phù hợp với bộ lọc.</p>
<script src="${pageContext.request.contextPath}/js/teacher-ui.js" defer></script>