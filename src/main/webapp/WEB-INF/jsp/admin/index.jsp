<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<span class="eyebrow">KHÔNG GIAN QUẢN TRỊ</span><h1 class="h2">Nội dung tốt. Hành trình học tốt.</h1><p class="text-muted">Quản lý tối đa 200 mục gần nhất ở mỗi danh sách. Nội dung mới ở trạng thái nháp trước khi xuất bản.</p><p id="adminNotice" role="alert" aria-live="polite"></p>
<jsp:include page="/WEB-INF/jsp/admin/ai-settings.jsp"/>
<div class="row g-4"><section class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">Tạo tài khoản</h2><form class="adminForm" data-endpoint="users"><label class="form-label" for="newName">Họ tên</label><input id="newName" name="fullName" class="form-control mb-2" required maxlength="160"><label for="newUsername">Tên đăng nhập</label><input id="newUsername" name="username" class="form-control mb-2" required pattern="[A-Za-z0-9._-]{3,80}"><label for="newEmail">Email</label><input id="newEmail" name="email" type="email" class="form-control mb-2" required maxlength="160"><label for="newPassword">Mật khẩu riêng (8–72 byte)</label><input id="newPassword" name="password" type="password" class="form-control mb-2" required minlength="8" maxlength="72" autocomplete="new-password"><label for="newRole">Vai trò</label><select id="newRole" name="role" class="form-select mb-3"><option value="TEACHER">Giáo viên</option><option value="STUDENT">Học sinh</option><option value="PARENT">Phụ huynh</option></select><button class="btn btn-primary">Tạo tài khoản</button></form></div></div></section>
<section class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">Tạo bài học</h2><form class="adminForm" data-endpoint="lessons"><label for="lessonTopic">Chủ đề</label><select id="lessonTopic" name="topicId" class="form-select mb-2"><c:forEach var="topic" items="${data.topics}"><option value="${topic.id}"><c:out value="${topic.name}"/></option></c:forEach></select><label for="lessonTitle">Tiêu đề</label><input id="lessonTitle" name="title" class="form-control mb-2" required maxlength="200"><label for="lessonSummary">Tóm tắt</label><input id="lessonSummary" name="summary" class="form-control mb-2" required maxlength="500"><label for="lessonObjectives">Mục tiêu</label><input id="lessonObjectives" name="objectives" class="form-control mb-2" required maxlength="2000"><label for="lessonHtml">Nội dung (HTML cơ bản được lọc an toàn)</label><textarea id="lessonHtml" name="contentHtml" class="form-control mb-2" required rows="5" maxlength="100000"></textarea><div class="row g-2"><div class="col-4"><label for="lessonDuration">Số phút</label><input id="lessonDuration" name="durationMinutes" type="number" value="30" min="1" max="180" class="form-control mb-2" required></div><div class="col-4"><label for="lessonPrerequisite">Bài tiên quyết</label><select id="lessonPrerequisite" name="prerequisiteId" class="form-select mb-2"><option value="">Không</option><c:forEach var="lesson" items="${data.lessons}"><c:if test="${lesson.status=='PUBLISHED'}"><option value="${lesson.id}">#${lesson.id}</option></c:if></c:forEach></select></div><div class="col-4"><label for="lessonScore">Điểm yêu cầu</label><input id="lessonScore" name="requiredScore" type="number" value="0" min="0" max="10" step="0.5" class="form-control mb-2" required></div></div><button class="btn btn-primary">Lưu bản nháp</button></form></div></div></section>
<section class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">Thêm câu hỏi</h2><form class="adminForm" data-endpoint="questions"><label for="questionText">Câu hỏi</label><textarea id="questionText" name="content" class="form-control mb-2" required maxlength="5000"></textarea><label for="questionExplain">Giải thích đáp án</label><textarea id="questionExplain" name="explanation" class="form-control mb-2" required maxlength="5000"></textarea><label for="questionOptions">Phương án (mỗi dòng một phương án)</label><textarea id="questionOptions" name="options" class="form-control mb-2" required rows="4" maxlength="6000"></textarea><div class="row g-2"><div class="col-6"><label for="questionCorrect">Đáp án đúng (1–6)</label><input id="questionCorrect" name="correctIndex" type="number" value="1" min="1" max="6" class="form-control mb-3" required></div><div class="col-6"><label for="questionDifficulty">Độ khó</label><select id="questionDifficulty" name="difficulty" class="form-select mb-3"><option value="EASY">Dễ</option><option value="MEDIUM">Vừa</option><option value="HARD">Khó</option></select></div></div><button class="btn btn-primary">Thêm câu hỏi</button></form></div></div></section>
<section class="col-lg-6"><div class="card"><div class="card-body"><h2 class="h5">Tạo quiz</h2><form class="adminForm" data-endpoint="quizzes"><label for="quizTitle">Tiêu đề</label><input id="quizTitle" name="title" class="form-control mb-2" required maxlength="200"><label for="quizLesson">Bài học</label><select id="quizLesson" name="lessonId" class="form-select mb-2"><option value="">Quiz tổng hợp</option><c:forEach var="lesson" items="${data.lessons}"><option value="${lesson.id}"><c:out value="${lesson.title}"/></option></c:forEach></select><label for="quizQuestions">ID câu hỏi, phân cách dấu phẩy</label><input id="quizQuestions" name="questionIds" class="form-control mb-2" required placeholder="1,2,3"><div class="row g-2"><div class="col-6"><label for="quizDuration">Phút</label><input id="quizDuration" name="durationMinutes" type="number" min="1" max="180" value="15" class="form-control mb-3" required></div><div class="col-6"><label for="quizAttempts">Số lượt</label><input id="quizAttempts" name="maxAttempts" type="number" min="1" max="100" value="3" class="form-control mb-3" required></div></div><label for="quizMode">Chế độ</label><select id="quizMode" name="mode" class="form-select mb-2"><option value="PRACTICE">Luyện tập</option><option value="TEST">Bài kiểm tra</option></select><label for="quizReveal">Công bố đáp án (bắt buộc cho bài kiểm tra, giờ thiết bị)</label><input id="quizReveal" name="revealAfter" type="datetime-local" class="form-control mb-3"><button class="btn btn-primary">Lưu quiz nháp</button></form></div></div></section></div>
<section class="mt-5"><h2 class="h5">Tài khoản</h2><div class="table-responsive"><table class="table"><thead><tr><th>Họ tên</th><th>Tên đăng nhập</th><th>Vai trò</th><th>Trạng thái</th></tr></thead><tbody><c:forEach var="user" items="${data.users}"><tr><td><c:out value="${user.full_name}"/></td><td><c:out value="${user.username}"/></td><td><c:out value="${user.role}"/></td><td><c:if test="${user.role!='ADMIN'}"><button class="btn btn-sm btn-outline-secondary adminState" data-endpoint="users/${user.id}/state" data-enabled="${not user.enabled}">${user.enabled?'Khóa tài khoản':'Mở khóa'}</button></c:if></td></tr></c:forEach></tbody></table></div></section>
<section class="mt-4"><h2 class="h5">Bài học</h2><div class="table-responsive"><table class="table"><thead><tr><th>ID</th><th>Bài học</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="lesson" items="${data.lessons}"><tr><td>${lesson.id}</td><td><c:out value="${lesson.title}"/></td><td><c:out value="${lesson.status}"/></td><td><button class="btn btn-sm btn-outline-primary adminState" data-endpoint="lessons/${lesson.id}/publish" data-enabled="${lesson.status!='PUBLISHED'}">${lesson.status=='PUBLISHED'?'Lưu trữ':'Xuất bản'}</button></td></tr></c:forEach></tbody></table></div></section>
<section class="mt-4"><h2 class="h5">Quiz</h2><ul class="list-group"><c:forEach var="quiz" items="${data.quizzes}"><li class="list-group-item d-flex justify-content-between align-items-center gap-3"><span>#${quiz.id} · <c:out value="${quiz.title}"/></span><button class="btn btn-sm btn-outline-primary adminState" data-endpoint="quizzes/${quiz.id}/publish" data-enabled="${not quiz.published}">${quiz.published?'Ngừng xuất bản':'Xuất bản'}</button></li></c:forEach></ul></section>
<section class="mt-4"><h2 class="h5">Ngân hàng câu hỏi</h2><ul class="list-group"><c:forEach var="question" items="${data.questions}"><li class="list-group-item">#${question.id} · <c:out value="${question.content}"/> <span class="badge text-bg-light"><c:out value="${question.difficulty}"/></span></li></c:forEach></ul></section>
<script src="${pageContext.request.contextPath}/js/admin.js" defer></script>
<script src="${pageContext.request.contextPath}/js/admin-ai.js" defer></script>