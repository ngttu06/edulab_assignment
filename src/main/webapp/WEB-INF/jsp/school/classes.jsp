<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="../teacher/nav.jspf" %>
<div class="teacher-heading"><h1>Lớp học</h1><p>Chọn lớp để quản lý học sinh, giao bài và xem kết quả.</p><c:if test="${pageContext.request.isUserInRole('ADMIN')}"><a class="btn btn-primary" href="${pageContext.request.contextPath}/teacher/classes/new">Tạo lớp khối 8</a></c:if></div>
<div class="classroom-grid"><c:forEach var="classroom" items="${classes}"><article class="classroom-card"><h3 class="classroom-name"><c:out value="${classroom.name}"/></h3><p class="classroom-year"><c:out value="${classroom.academic_year}"/></p><a class="btn btn-primary btn-sm" href="${pageContext.request.contextPath}/teacher/classes/${classroom.id}">Quản lý lớp</a></article></c:forEach></div>
<c:if test="${empty classes}"><div class="empty-state"><h2>Chưa có lớp được phân công</h2><p>Lớp học sẽ xuất hiện tại đây sau khi quản trị viên phân công.</p></div></c:if>
<c:if test="${not empty archivedClasses}"><section class="mt-5"><h2 class="h5">Lớp đã lưu trữ</h2><ul class="list-group"><c:forEach var="classroom" items="${archivedClasses}"><li class="list-group-item"><a href="${pageContext.request.contextPath}/teacher/classes/${classroom.id}"><c:out value="${classroom.name}"/></a> · <c:out value="${classroom.academic_year}"/></li></c:forEach></ul></section></c:if>
