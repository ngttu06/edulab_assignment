# Reference only: Spring Boot does not automatically load .env.
# Export variables in your shell/IDE; never commit real credentials.
SPRING_PROFILES_ACTIVE=local
# Public-key retrieval is for local loopback only; never copy this URL to remote.
EDULAB_DB_URL='jdbc:mysql://localhost:3306/edulab_assignment?useUnicode=true&characterEncoding=utf8&sslMode=DISABLED&allowPublicKeyRetrieval=true&serverTimezone=UTC'
EDULAB_DB_USERNAME=edulab
EDULAB_DB_PASSWORD=edulab_local_password
# Generate your own value with: openssl rand -base64 48
EDULAB_JWT_SECRET=replace-with-your-generated-base64-secret
EDULAB_UPLOAD_ROOT=./storage
EDULAB_DEV_SCAN_BYPASS=false
EDULAB_AI_ENABLED=false
EDULAB_AI_DAILY_REQUEST_LIMIT=20
# For remote: SPRING_PROFILES_ACTIVE=remote, HTTPS, secure cookies,
# private upload directory, unique credentials, and sslMode=VERIFY_IDENTITY.
