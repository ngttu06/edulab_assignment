<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<a class="admin-back-link" href="${pageContext.request.contextPath}/admin/${resource.key()}">← <c:out value="${resource.title()}"/></a>
<div class="admin-page-heading"><div><span class="admin-eyebrow"><c:out value="${resource.title()}"/> / #${item.id}</span><h1 class="admin-detail-title"><c:out value="${item[resource.label()]}"/></h1><span class="admin-badge ${item.inactive ? 'muted' : 'success'}"><c:out value="${item.stateLabel}"/></span></div><c:if test="${not resource.readOnly()}"><div class="admin-heading-actions"><c:choose><c:when test="${item.inactive and resource.key() != 'assignments' and resource.key() != 'files'}"><button class="btn btn-primary" data-admin-action="restore" data-resource="${resource.key()}" data-id="${item.id}">Khôi phục</button></c:when><c:when test="${not item.inactive}"><a class="btn btn-primary" href="${pageContext.request.contextPath}/admin/${resource.key()}/${item.id}/edit">Chỉnh sửa</a><button class="btn btn-outline-danger" data-admin-action="delete" data-resource="${resource.key()}" data-id="${item.id}" data-return-list="true">${empty resource.state() ? 'Xóa' : resource.key() == 'files' ? 'Chặn tệp' : 'Ngừng / lưu trữ'}</button></c:when></c:choose></div></c:if></div>
<c:if test="${resource.key() == 'files'}"><p class="admin-footnote">Chỉ tệp CLEAN mới được tải xuống. Chặn tệp giữ nguyên dữ liệu và liên kết, nhưng không cho tải xuống; không thể bỏ qua scanner bằng chức năng khôi phục.</p><c:if test="${item.scan_status == 'CLEAN'}"><a class="btn btn-outline-secondary mb-3" href="${pageContext.request.contextPath}/api/v1/files/${item.id}">Tải tệp đã kiểm tra</a></c:if></c:if>
<c:if test="${resource.key() == 'classes'}"><nav class="admin-tabs" aria-label="Các phần của lớp học"><a href="#recordInfo">Tổng quan</a><a href="#classTeachers">Giáo viên phụ trách</a><a href="#classStudents">Học sinh</a><a href="#classAssignments">Bài đã giao</a><a href="#classResults">Kết quả</a></nav></c:if>
<section class="admin-panel" id="recordInfo"><div class="admin-panel-heading"><h2>Thông tin chi tiết</h2></div><dl class="admin-description-list">
<c:forEach var="column" items="${resource.columns()}"><div><dt><c:out value="${column.label()}"/></dt><dd><c:out value="${item[column.key()]}" default="—"/></dd></div></c:forEach>
<c:forEach var="field" items="${resource.fields()}"><c:if test="${field.type() == 'textarea' or field.type() == 'date' or field.type() == 'datetime-local'}"><div class="admin-description-wide"><dt><c:out value="${field.label()}"/></dt><dd class="admin-preformatted"><c:out value="${item[field.key()]}" default="—"/></dd></div></c:if></c:forEach>
</dl></section>
<c:if test="${resource.key() == 'audit-logs' and not empty item.metadata_json}"><section class="admin-panel admin-section"><div class="admin-panel-heading"><h2>Chi tiết thao tác</h2></div><pre class="admin-preformatted"><c:out value="${item.metadata_json}"/></pre></section></c:if>
<c:if test="${resource.key() == 'classes'}">
<section class="admin-panel admin-section" id="classTeachers"><div class="admin-panel-heading"><div><h2>Giáo viên phụ trách</h2><p>Một người phụ trách chính; có thể có nhiều giáo viên giảng dạy.</p></div></div>
<c:if test="${not item.inactive}"><form class="admin-relationship-form" data-relationship="teacher"><input type="hidden" name="classId" value="${item.id}"><ui:adminReference name="teacherId" label="Chọn giáo viên" resource="teachers" required="true"/><div><label class="form-label" for="homeroom">Vai trò trong lớp</label><select id="homeroom" name="homeroom" class="form-select"><option value="false">Giáo viên giảng dạy</option><option value="true">Phụ trách chính / chủ nhiệm</option></select></div><button class="btn btn-primary">Lưu phân công</button></form></c:if>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Giáo viên</th><th>Tên đăng nhập</th><th>Vai trò</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="teacher" items="${related.teachers}"><tr><td><a href="${pageContext.request.contextPath}/admin/teachers/${teacher.id}"><c:out value="${teacher.full_name}"/></a></td><td><c:out value="${teacher.username}"/></td><td><span class="admin-badge">${teacher.is_homeroom_teacher ? 'Phụ trách chính' : 'Giảng dạy'}</span></td><td><c:if test="${not item.inactive}"><button class="btn btn-sm btn-outline-danger" data-remove-teacher="${teacher.id}" data-class-id="${item.id}">Thu hồi</button></c:if></td></tr></c:forEach><c:if test="${empty related.teachers}"><tr><td colspan="4" class="admin-empty">Chưa có giáo viên. Hãy tạo phân công cho lớp này.</td></tr></c:if></tbody></table></div></section>
<section class="admin-panel admin-section" id="classStudents"><div class="admin-panel-heading"><div><h2>Học sinh trong lớp</h2><p>Tối đa 200 thành viên gần nhất theo tên. Rời lớp không xóa lịch sử học tập.</p></div></div>
<c:if test="${not item.inactive}"><form class="admin-relationship-form" data-relationship="student" data-class-id="${item.id}"><ui:adminReference name="studentId" label="Chọn học sinh" resource="students" required="true"/><button class="btn btn-primary">Thêm vào lớp</button></form></c:if>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Học sinh</th><th>Tên đăng nhập</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="student" items="${related.students}"><tr><td><a href="${pageContext.request.contextPath}/admin/students/${student.id}"><c:out value="${student.full_name}"/></a></td><td><c:out value="${student.username}"/></td><td><span class="admin-badge">${student.active ? 'Đang học' : 'Đã rời lớp'}</span></td><td><c:if test="${not item.inactive}"><button class="btn btn-sm btn-outline-secondary" data-enrollment="${student.id}" data-class-id="${item.id}" data-active="${not student.active}">${student.active ? 'Cho rời lớp' : 'Thêm lại'}</button></c:if></td></tr></c:forEach><c:if test="${empty related.students}"><tr><td colspan="4" class="admin-empty">Lớp chưa có học sinh.</td></tr></c:if></tbody></table></div></section>
<section class="admin-panel admin-section" id="classAssignments"><div class="admin-panel-heading"><h2>Bài đã giao</h2><a href="${pageContext.request.contextPath}/admin/assignments/new">＋ Giao bài</a></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Bài tập / quiz</th><th>Hạn nộp</th><th>Trạng thái</th></tr></thead><tbody><c:forEach var="assignment" items="${related.assignments}"><tr><td><a href="${pageContext.request.contextPath}/admin/assignments/${assignment.id}"><c:out value="${assignment.title}"/></a></td><td><c:out value="${assignment.due_at}"/></td><td>${empty assignment.cancelled_at ? 'Đang giao' : 'Đã hủy'}</td></tr></c:forEach><c:if test="${empty related.assignments}"><tr><td colspan="3" class="admin-empty">Chưa có bài đã giao.</td></tr></c:if></tbody></table></div></section>
<section class="admin-panel admin-section" id="classResults"><div class="admin-panel-heading"><div><h2>Kết quả học tập</h2><p>Các lượt làm đã chấm của quiz được giao trong lớp; tối đa 200 học sinh. CSV bao gồm chi tiết quiz được giao/chia sẻ.</p></div><a href="${pageContext.request.contextPath}/admin/classes/${item.id}/results.csv">Xuất CSV</a></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Học sinh</th><th>Lượt đã chấm</th><th>Điểm trung bình</th></tr></thead><tbody><c:forEach var="result" items="${related.results}"><tr><td><c:out value="${result.full_name}"/></td><td>${result.attempts}</td><td><c:out value="${result.average_score}" default="Chưa có điểm"/></td></tr></c:forEach><c:if test="${empty related.results}"><tr><td colspan="3" class="admin-empty">Chưa có kết quả để hiển thị.</td></tr></c:if></tbody></table></div></section>
</c:if>
<c:if test="${resource.key() == 'teachers' or resource.key() == 'students'}"><section class="admin-panel admin-section"><div class="admin-panel-heading"><h2>${resource.key() == 'teachers' ? 'Lớp đang phụ trách' : 'Lớp tham gia'}</h2><c:if test="${resource.key() == 'teachers'}"><a href="${pageContext.request.contextPath}/admin/teaching-assignments">Quản lý phân công →</a></c:if></div><div class="admin-linked-list"><c:forEach var="classroom" items="${related.classes}"><a href="${pageContext.request.contextPath}/admin/classes/${classroom.id}"><strong><c:out value="${classroom.name}"/></strong><span>Khối ${classroom.grade_level} →</span></a></c:forEach><c:if test="${empty related.classes}"><p class="admin-empty">Chưa liên kết với lớp học nào.</p></c:if></div></section></c:if>
<c:if test="${resource.key() == 'teachers'}"><section class="admin-panel admin-section"><div class="admin-panel-heading"><h2>Bài học đã tạo</h2></div><div class="admin-linked-list"><c:forEach var="lesson" items="${related.lessons}"><a href="${pageContext.request.contextPath}/admin/lessons/${lesson.id}"><strong><c:out value="${lesson.title}"/></strong><span><c:out value="${lesson.status}"/> →</span></a></c:forEach><c:if test="${empty related.lessons}"><p class="admin-empty">Chưa có bài học.</p></c:if></div></section></c:if>
<c:if test="${resource.key() == 'students'}"><section class="admin-panel admin-section"><div class="admin-panel-heading"><h2>Tiến độ bài học</h2></div><div class="admin-linked-list"><c:forEach var="progress" items="${related.progress}"><div><strong><c:out value="${progress.title}"/></strong><span>${progress.completion_percent}% · <c:out value="${progress.status}"/></span></div></c:forEach><c:if test="${empty related.progress}"><p class="admin-empty">Chưa có tiến độ học tập.</p></c:if></div></section></c:if>