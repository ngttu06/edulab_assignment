<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<span class="eyebrow">HỌC CÓ ĐỊNH HƯỚNG</span><h1 class="h2">Hành trình khám phá của em</h1><p class="text-muted mb-4">Học kiến thức → luyện quiz → ôn tập → bước tiếp theo. Tiến độ hoàn thành do em đánh dấu; điểm quiz phản ánh kết quả luyện tập riêng.</p>
<ui:catalogFilters action="/roadmap" filter="${filter}" subjects="${subjects}" grades="${grades}" courses="${courseOptions}"/>
<c:forEach var="step" items="${steps}" varStatus="index"><article class="path-step ${step.progress_status == 'COMPLETED' ? 'done' : ''}"><span class="step-badge">${index.count}</span><div class="step-content"><p class="small text-primary mb-1"><c:out value="${step.topic_name}"/></p><h2><c:out value="${step.title}"/></h2><p class="small text-muted"><c:out value="${step.duration_minutes}"/> phút · <c:choose><c:when test="${step.progress_status == 'COMPLETED'}">Đã hoàn thành</c:when><c:when test="${step.progress_status == 'IN_PROGRESS'}">Đang học</c:when><c:otherwise>Chưa bắt đầu</c:otherwise></c:choose></p><c:choose><c:when test="${step.unlocked}"><a class="btn btn-primary btn-sm" href="${pageContext.request.contextPath}/lessons/${step.id}">Học bài này →</a></c:when><c:otherwise><p class="small mb-0">Hoàn thành bài tiên quyết #${step.prerequisite_id}; điểm quiz yêu cầu: <c:out value="${step.required_score}"/>/10.</p></c:otherwise></c:choose></div></article></c:forEach>
<c:if test="${empty steps}"><p class="alert alert-info">Chưa có bài học trong lộ trình. Giáo viên đang chuẩn bị nội dung.</p></c:if>