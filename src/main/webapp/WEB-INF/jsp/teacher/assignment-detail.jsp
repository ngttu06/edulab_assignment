<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="class-nav.jspf" %>
<h1 class="h3"><c:out value="${item.title}"/></h1><p>Giao lúc (UTC): <c:out value="${item.created_at}"/></p><p>Hạn hoàn thành (UTC): <c:out value="${item.due_at}"/></p><p>${empty item.cancelled_at ? 'Đã giao' : 'Đã hủy — lịch sử được giữ lại'}</p>
<p id="workspaceNotice" role="status" aria-live="polite"></p>
<c:if test="${empty item.cancelled_at and empty classroom.archived_at}"><a class="btn btn-primary" href="${pageContext.request.contextPath}/teacher/classes/${classId}/assignments/${item.id}/edit">Sửa hạn nộp</a><button class="btn btn-outline-danger" data-delete="/api/v1/teacher/classes/${classId}/assignments/${item.id}" data-return="/teacher/classes/${classId}/assignments" data-confirm="Hủy bài giao? Quiz và lịch sử làm bài không bị xóa.">Hủy giao bài</button></c:if>
<h2 class="h5 mt-4">Theo dõi nộp bài</h2><p class="text-muted">Hoàn thành đúng hạn chỉ tính lượt đã chấm từ lúc giao đến hạn nộp của bài này. Điểm tổng hợp của quiz có thể bao gồm các lượt làm khác.</p>
<div class="table-responsive teacher-table" tabindex="0" role="region" aria-label="Tình trạng nộp bài của học sinh"><table class="table align-middle"><thead><tr><th>Học sinh</th><th>Thành viên</th><th>Bài giao này</th><th>Kết quả quiz</th></tr></thead><tbody><c:forEach var="student" items="${submissions}"><tr><td><c:out value="${student.full_name}"/></td><td>${student.active ? 'Đang học' : 'Đã ngừng tham gia'}</td><td><span class="teacher-badge ${student.completed ? 'is-live' : 'is-muted'}">${student.completed ? 'Đã hoàn thành đúng hạn' : 'Chưa hoàn thành đúng hạn'}</span></td><td><a href="${pageContext.request.contextPath}/teacher/classes/${classId}/students/${student.id}/results">Xem kết quả</a></td></tr></c:forEach></tbody></table></div><c:if test="${empty submissions}"><p>Lớp chưa có học sinh.</p></c:if>
<script src="${pageContext.request.contextPath}/js/teacher-workspace.js" defer></script>