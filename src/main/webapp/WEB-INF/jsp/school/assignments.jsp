<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<section class="my-4"><h2 class="section-title">Bài được giao</h2>
<div class="task-grid"><c:forEach var="assignment" items="${assignments}"><article class="task-card ${assignment.overdue ? 'is-overdue' : (assignment.completed ? 'is-complete' : 'is-pending')}"><div class="task-status"><c:choose><c:when test="${assignment.completed}"><span class="status-badge status-complete">Đã hoàn thành</span></c:when><c:when test="${assignment.overdue}"><span class="status-badge status-overdue">Quá hạn</span></c:when><c:otherwise><span class="status-badge status-pending">Cần hoàn thành</span></c:otherwise></c:choose></div><h3 class="task-title"><c:out value="${assignment.title}"/></h3><p class="task-meta"><c:out value="${assignment.class_name}"/> · Hạn: <c:out value="${assignment.due_at}"/> UTC</p><c:if test="${not assignment.completed}"><a class="btn btn-primary btn-sm" href="${pageContext.request.contextPath}/quizzes">Làm bài</a></c:if></article></c:forEach></div>
<c:if test="${empty assignments}"><p class="text-muted">Chưa có bài được giao.</p></c:if></section>
<section class="card my-4"><div class="card-body"><h2 class="h5">Nhận xét từ giáo viên</h2><c:forEach var="item" items="${feedback}"><div class="feedback-item"><strong><c:out value="${item.teacher}"/></strong><p class="mb-1"><c:out value="${item.body}"/></p><small class="text-muted"><c:out value="${item.created_at}"/> UTC</small></div></c:forEach><c:if test="${empty feedback}"><p class="text-muted mb-0">Chưa có nhận xét.</p></c:if></div></section>