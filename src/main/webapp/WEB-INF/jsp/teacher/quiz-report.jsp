<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="nav.jspf" %>
<a href="${pageContext.request.contextPath}/teacher/quizzes">← Quiz &amp; đề kiểm tra</a>
<h1 class="h3 my-3">Báo cáo: <c:out value="${report.quiz.title}"/></h1>
<form method="get" class="row g-2 mb-3"><div class="col-md-5"><label for="reportClass" class="form-label">Lớp</label><select id="reportClass" name="classId" class="form-select"><option value="0">Tất cả lớp trong phạm vi được xem</option><c:forEach var="cl" items="${report.classes}"><option value="${cl.id}" ${report.classId == cl.id ? 'selected' : ''}><c:out value="${cl.name}"/></option></c:forEach></select></div><div class="col-md-5"><label for="reportSelection" class="form-label">Cách tính phổ điểm</label><select id="reportSelection" name="selection" class="form-select"><option value="latest" ${report.selection == 'latest' ? 'selected' : ''}>Lượt đã chấm gần nhất / học sinh</option><option value="best" ${report.selection == 'best' ? 'selected' : ''}>Điểm cao nhất / học sinh</option><option value="all" ${report.selection == 'all' ? 'selected' : ''}>Tất cả lượt đã chấm</option></select></div><div class="col-md-2 align-self-end"><button class="btn btn-primary">Xem báo cáo</button></div></form>
<p>${report.stats.studentCount} học sinh · ${report.stats.completed} đã có điểm · ${report.stats.inProgress} đã bắt đầu nhưng chưa có điểm · ${report.stats.notStarted} chưa làm</p>
<p>Điểm trung bình: <strong><c:out value="${report.stats.average}" default="—"/></strong> · Cao nhất: <c:out value="${report.stats.highest}" default="—"/> · Thấp nhất: <c:out value="${report.stats.lowest}" default="—"/> /10</p>
<section class="card mb-3"><div class="card-body"><h2 class="h5">Phổ điểm</h2><p>${report.stats.sampleCount} kết quả theo cách tính đã chọn. Học sinh chưa làm không tính thành điểm 0. Khoảng cuối bao gồm điểm 10.</p><p class="small text-muted">Trên màn hình nhỏ, cuộn ngang biểu đồ để xem đủ các khoảng điểm.</p><div class="table-responsive" tabindex="0" role="region" aria-label="Biểu đồ phổ điểm có thể cuộn ngang"><svg id="scoreChart" viewBox="0 0 650 300" role="img" aria-labelledby="chartTitle chartDesc" class="assessment-chart"><title id="chartTitle">Biểu đồ cột phổ điểm</title><desc id="chartDesc">Số kết quả theo 10 khoảng điểm; số liệu đầy đủ nằm trong bảng bên dưới.</desc></svg></div><div class="table-responsive"><table class="table table-sm"><caption>Số kết quả theo khoảng điểm</caption><thead><tr><th>Khoảng điểm</th><th>Số kết quả</th></tr></thead><tbody id="scoreBins"><c:forEach var="bin" items="${report.bins}"><tr data-count="${bin.count}" data-label="${bin.label}"><td>${bin.label}</td><td>${bin.count}</td></tr></c:forEach></tbody></table></div></div></section>
<p><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/teacher/quizzes/${report.quiz.id}/report.csv?classId=${report.classId}">Xuất tất cả lượt làm CSV</a></p>
<h2 class="h5">Lượt làm của học sinh</h2><div class="row g-2 mb-3"><div class="col-md-8"><label for="attemptSearch" class="form-label">Tìm học sinh</label><input id="attemptSearch" type="search" class="form-control" maxlength="200" placeholder="Họ tên hoặc tên đăng nhập"></div><div class="col-md-4"><label for="attemptStatus" class="form-label">Trạng thái lượt làm</label><select id="attemptStatus" class="form-select"><option value="all">Tất cả</option><option value="GRADED">Đã chấm</option><option value="IN_PROGRESS">Đang làm</option></select></div></div>
<div class="table-responsive"><table class="table"><thead><tr><th>Học sinh</th><th>Lượt</th><th>Trạng thái</th><th>Điểm /10</th><th>Rời tab</th><th>Nộp (UTC)</th><th></th></tr></thead><tbody id="reportAttempts"><c:forEach var="a" items="${report.attempts}"><tr><td><c:out value="${a.full_name}"/><br><small><c:out value="${a.username}"/></small></td><td>${a.attempt_number}</td><td>${a.status == 'GRADED' ? 'Đã chấm' : 'Đang làm'}</td><td><c:out value="${a.score}" default="—"/></td><td>${a.mode_snapshot == 'TEST' ? a.tab_count : '—'}</td><td><c:out value="${a.submitted_at}" default="—"/></td><td><a href="${pageContext.request.contextPath}/teacher/quiz-attempts/${a.id}">Xem bài làm</a></td></tr></c:forEach></tbody></table></div>
<c:if test="${empty report.attempts}"><p>Chưa có lượt làm nào trong phạm vi lớp được chọn.</p></c:if>
<details><summary>Danh sách học sinh và trạng thái (${report.students.size()})</summary><ul><c:forEach var="s" items="${report.students}"><li><c:out value="${s.full_name}"/> · <c:out value="${s.username}"/> — ${s.result_status == 'GRADED' ? 'Đã có điểm' : s.result_status == 'IN_PROGRESS' ? 'Đang làm' : 'Chưa làm'}</li></c:forEach></ul></details>
<script src="${pageContext.request.contextPath}/js/quiz-report.js" defer></script>