# Only application build inputs enter the context. Never send secrets, uploads,
# database backups, local tooling, tests or Git history to the Docker builder.
**
!pom.xml
!src/
!src/main/
!src/main/**
!docker/
!docker/entrypoint.sh
!Dockerfile
.env*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/.DS_Store