<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<div class="social-page">
    <nav class="discovery-tabs" aria-label="Khám phá EduLab"><a href="${pageContext.request.contextPath}/"><ui:icon name="home"/>Trang chủ</a><a class="is-active" href="${pageContext.request.contextPath}/community" aria-current="page"><ui:icon name="users"/>Cộng đồng</a></nav>
    <div class="social-columns"><div class="social-main">
        <c:if test="${not detail}"><section id="socialComposer" class="social-surface social-composer" aria-labelledby="socialComposerTitle">
            <h2 id="socialComposerTitle" class="visually-hidden">Tạo bài viết</h2>
            <form id="socialForm">
                <div class="social-composer-row"><span class="social-avatar" aria-hidden="true"><ui:icon name="user"/></span><div class="social-composer-input"><label for="socialBody" class="visually-hidden">Nội dung bài viết</label><textarea id="socialBody" class="social-textarea" rows="1" maxlength="3000" placeholder="Bạn đang nghĩ gì?" aria-describedby="socialAudience socialFileHint"></textarea><p id="socialAudience" class="social-audience"><ui:icon name="users"/> Chia sẻ với cộng đồng EduLab</p></div></div>
                <div id="socialPreview" class="social-preview" aria-label="Ảnh đã chọn"></div>
                <p id="socialUploadStatus" class="social-hint" role="status" aria-live="polite"></p>
                <div class="social-composer-footer"><label for="socialFiles" class="social-photo-button"><ui:icon name="photo"/> Thêm ảnh</label><input type="file" id="socialFiles" class="visually-hidden" accept="image/jpeg,image/png,image/webp" aria-describedby="socialFileHint" multiple><button id="socialCancelUpload" type="button" class="btn btn-outline-secondary" hidden>Hủy upload</button><button id="socialPublish" type="submit" class="btn btn-primary">Đăng bài</button></div>
                <p id="socialFileHint" class="social-hint social-file-hint">Tối đa 5 ảnh · Tự động nén và kiểm tra an toàn</p>
            </form>
        </section></c:if>
        <div class="social-feed-heading"><h1>${detail ? 'Bài viết' : 'Bảng tin'}</h1><c:if test="${not detail}"><nav class="social-filters" aria-label="Lọc bài viết"><a href="${pageContext.request.contextPath}/community" class="${not mine ? 'is-active' : ''}" ${not mine ? 'aria-current="page"' : ''}>Mới nhất</a><a href="${pageContext.request.contextPath}/community?mine=true" class="${mine ? 'is-active' : ''}" ${mine ? 'aria-current="page"' : ''}>Bài của tôi</a></nav></c:if></div>
        <div id="socialFeed" class="social-feed" data-cursor="${nextCursor}" data-mine="${mine}" data-detail="${detail}" data-admin="${pageContext.request.isUserInRole('ADMIN')}">
            <c:forEach var="post" items="${posts}"><article class="social-surface social-post" data-id="${post.id}">
                <div class="social-post-head"><span class="social-avatar" aria-hidden="true"><c:out value="${fn:substring(post.author,0,1)}"/></span><div class="social-post-author"><strong><c:out value="${post.author}"/></strong><a class="social-post-time" href="${pageContext.request.contextPath}/community/posts/${post.id}" aria-label="Xem bài viết"><time><c:out value="${post.created_at}"/></time><span aria-hidden="true"> · </span><ui:icon name="users"/></a></div><details class="social-post-menu"><summary aria-label="Tùy chọn bài viết"><ui:icon name="more"/></summary><div class="social-menu-items"><c:if test="${post.mine}"><button type="button" data-action="edit">Sửa bài viết</button><button type="button" data-action="delete">Xóa bài viết</button></c:if><c:if test="${not post.mine}"><button type="button" data-action="report">Báo cáo bài viết</button></c:if><c:if test="${pageContext.request.isUserInRole('ADMIN')}"><button type="button" data-action="hide">Ẩn bài viết</button></c:if></div></details></div>
                <p class="social-post-text"><c:out value="${post.body}"/></p>
                <c:if test="${not empty post.images}"><div class="social-gallery ${post.images.size() == 1 ? 'single' : ''}" data-count="${post.images.size()}"><c:forEach var="image" items="${post.images}" varStatus="idx"><c:choose><c:when test="${image.scan_status == 'CLEAN'}"><a href="${pageContext.request.contextPath}/api/v1/files/${image.id}/image" target="_blank" rel="noopener" aria-label="Xem ảnh ${idx.count} trong bài viết"><img src="${pageContext.request.contextPath}/api/v1/files/${image.id}/image" loading="lazy" alt="Ảnh ${idx.count} được chia sẻ trong bài viết"/></a></c:when><c:otherwise><span class="social-image-pending">Ảnh đang được kiểm tra an toàn.</span></c:otherwise></c:choose></c:forEach></div></c:if>
                <div class="social-counts"><span class="social-reaction-summary"><span class="social-reaction-stack" aria-hidden="true"><c:forEach var="entry" items="${post.reaction_counts}" end="2"><ui:icon name="reaction-${fn:toLowerCase(entry.key)}"/></c:forEach></span><span class="social-like-count">${post.like_count}</span> cảm xúc</span><button type="button" data-action="comment-count" class="social-comment-total"><span class="social-comment-count">${post.comment_count}</span> bình luận</button></div>
                <div class="social-actions"><div class="social-reaction-control"><button type="button" data-action="like" data-reaction="${post.reaction}" aria-pressed="${post.liked}"><ui:icon name="${empty post.reaction ? 'like' : 'reaction-'.concat(fn:toLowerCase(post.reaction))}"/><span>${empty post.reaction_label ? 'Thích' : post.reaction_label}</span></button></div><button type="button" data-action="comments" aria-expanded="false" aria-controls="socialComments${post.id}"><ui:icon name="chat"/> Bình luận</button><button type="button" data-action="share"><ui:icon name="share"/> Chia sẻ</button></div><p class="social-post-notice" role="status" aria-live="polite"></p>
                <section id="socialComments${post.id}" class="social-comments" hidden aria-label="Bình luận"><div class="social-comments-heading"><h3>Bình luận</h3><span>Cũ nhất trước</span></div><div class="social-comment-list"></div><p class="social-comment-empty" hidden>Chưa có bình luận. Hãy bắt đầu cuộc trò chuyện!</p><button type="button" class="social-comment-more" hidden>Xem thêm bình luận</button><form class="social-comment-form"><span class="social-avatar social-comment-avatar" aria-hidden="true"><ui:icon name="user"/></span><div class="social-comment-compose"><label class="visually-hidden" for="socialComment${post.id}">Viết bình luận</label><div class="social-comment-field"><textarea id="socialComment${post.id}" rows="1" maxlength="1000" required placeholder="Viết bình luận..." aria-describedby="socialCommentHint${post.id}"></textarea><button type="submit" aria-label="Gửi bình luận" title="Gửi bình luận"><ui:icon name="send"/></button></div><p id="socialCommentHint${post.id}" class="social-comment-hint">Enter để gửi · Shift + Enter để xuống dòng</p></div></form></section>
            </article></c:forEach>
        </div>
        <c:if test="${empty posts}"><div id="socialEmpty" class="social-surface social-empty"><ui:icon name="users"/><h2>Chưa có bài viết nào</h2><p>Hãy bắt đầu một câu chuyện vui với cộng đồng nhé!</p><a href="#socialComposer">Viết bài đầu tiên →</a></div></c:if>
        <p id="socialFeedNotice" role="status" aria-live="polite"></p>
        <c:if test="${not detail}"><div class="social-pagination"><button id="socialMore" class="btn btn-outline-primary" type="button" ${not hasMore ? 'hidden' : ''}>Xem thêm bài viết</button><c:if test="${hasMore}"><c:url var="socialNext" value="/community"><c:param name="before" value="${nextCursor}"/><c:if test="${mine}"><c:param name="mine" value="true"/></c:if></c:url><noscript><a href="<c:out value='${socialNext}'/>">Trang tiếp theo →</a></noscript></c:if></div></c:if>
    </div><aside class="social-rail" aria-label="Thông tin cộng đồng"><div class="social-surface social-rail-card"><span class="social-kicker">CHÀO MỪNG BẠN</span><h2>Ở đây, cứ là chính mình.</h2><p>Chia sẻ những khoảnh khắc thường ngày, động viên nhau và cùng tạo nên một không gian dễ chịu.</p><a href="${pageContext.request.contextPath}/community${detail ? '' : '#socialComposer'}">${detail ? 'Đến bảng tin →' : 'Kể chuyện của bạn →'}</a></div><div class="social-surface social-rail-card"><h2>Góc nhỏ an toàn</h2><ul><li>Tôn trọng người khác khi trò chuyện.</li><li>Đừng đăng số điện thoại, địa chỉ hoặc thông tin riêng tư.</li><li>Chỉ chia sẻ hình ảnh bạn có quyền đăng.</li></ul><a href="${pageContext.request.contextPath}/forum">Cần hỏi bài? Đến Hỏi đáp học tập →</a></div></aside></div>
</div>
<script src="${pageContext.request.contextPath}/js/file-upload.js" defer></script>
<script src="${pageContext.request.contextPath}/js/social-community.js" defer></script>