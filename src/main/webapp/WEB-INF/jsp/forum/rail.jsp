<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<aside class="utility-column community-rail" aria-label="Tiện ích cộng đồng">
    <section class="study-promo"><span class="promo-label">CỘNG ĐỒNG EDULAB</span><h2>Một câu hỏi.<br>Nhiều góc nhìn.</h2><div class="community-promo-icon" aria-hidden="true"><ui:icon name="users"/></div><p>Cùng chia sẻ, cùng khám phá.<br>Hiểu sâu hơn mỗi ngày.</p><a class="btn btn-light" href="#composer">Chia sẻ câu hỏi →</a></section>
    <section class="panel utility-panel"><h2>Không gian thảo luận</h2><a class="utility-link" href="${pageContext.request.contextPath}/forum">Tất cả chuyên mục <span aria-hidden="true">›</span></a><c:forEach var="category" items="${categories}"><a class="utility-link" href="${pageContext.request.contextPath}/forum?category=${category.id}"><span class="nav-icon green"><ui:icon name="chat"/></span><span><strong><c:out value="${category.name}"/></strong><small><c:out value="${category.description}"/></small></span><span aria-hidden="true">›</span></a></c:forEach></section>
