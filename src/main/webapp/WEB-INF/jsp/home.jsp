<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<div class="home-discovery">
<nav class="discovery-tabs" aria-label="Khám phá EduLab"><a class="is-active" href="${pageContext.request.contextPath}/" aria-current="page"><ui:icon name="home"/>Trang chủ</a><a href="${pageContext.request.contextPath}/forum"><ui:icon name="users"/>Cộng đồng</a></nav>
<section class="home-banner"><div class="banner-copy"><span class="banner-kicker">EDULAB · HÀNH TRÌNH TRI THỨC</span><h1>Hiểu kiến thức.<br><span>Mở lối tư duy.</span></h1><p>Học từng bước, vững từ gốc.<br>Khám phá khóa học theo môn và khối lớp.</p><a class="btn btn-primary" href="${pageContext.request.contextPath}/courses">Khám phá ngay <span aria-hidden="true">→</span></a></div><div class="banner-illustration" aria-hidden="true"><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><div class="banner-book"><ui:icon name="book"/><strong>EduLab</strong><small>HỌC ĐỂ HIỂU</small></div><span class="formula formula-one">x² + 2xy + y²</span><span class="formula formula-two">H₂O</span><span class="formula formula-three">Hello!</span><span class="banner-star">✦</span></div></section>
<section class="panel home-statistics" aria-label="EduLab trong những con số"><div><span class="nav-icon blue"><ui:icon name="cap"/></span><strong>${statistics.courses}</strong><span>Khóa học</span></div><div><span class="nav-icon purple"><ui:icon name="book"/></span><strong>${statistics.lessons}</strong><span>Bài học công khai</span></div><div><span class="nav-icon green"><ui:icon name="users"/></span><strong>${statistics.teachers}</strong><span>Giáo viên phụ trách</span></div><div><span class="nav-icon orange"><ui:icon name="spark"/></span><strong>${statistics.subjects}</strong><span>Môn / khối lớp</span></div></section>
<section class="panel home-panel"><div class="section-heading"><h2 class="section-title">ĐỒNG HÀNH CÙNG GIÁO VIÊN</h2><a href="${pageContext.request.contextPath}/courses">Khám phá khóa học →</a></div><c:choose><c:when test="${not empty teachers}"><div class="teacher-grid"><c:forEach var="teacher" items="${teachers}"><a class="teacher-tile" href="${pageContext.request.contextPath}/courses/${teacher.course_id}"><span class="teacher-avatar" aria-hidden="true"><c:out value="${fn:substring(teacher.name,0,1)}"/></span><strong><c:out value="${teacher.name}"/></strong><span><c:out value="${teacher.subjects}"/></span><small>${teacher.course_count} khóa học phụ trách</small></a></c:forEach></div></c:when><c:otherwise><p class="text-muted mb-0">Thông tin giáo viên sẽ xuất hiện khi được liên kết với khóa học. Trong lúc chờ, bạn có thể trao đổi tại <a href="${pageContext.request.contextPath}/forum">Cộng đồng EduLab</a>.</p></c:otherwise></c:choose><p class="small text-muted mt-3 mb-0">Giáo viên được liên kết với khóa học trong hệ thống. Nội dung khởi động chưa thay thế chương trình học đầy đủ.</p></section>
<section class="panel home-panel"><div class="section-heading"><h2 class="section-title">KHÁM PHÁ MÔN HỌC</h2><a href="${pageContext.request.contextPath}/courses">Xem tất cả</a></div><div class="subject-strip"><c:forEach var="subject" items="${subjects}" varStatus="index"><a class="subject-tile subject-tone-${index.index % 4}" href="${pageContext.request.contextPath}/courses?subjectId=${subject.id}"><span class="subject-tile-art"><ui:icon name="${subject.name == 'Toán' ? 'chart' : (subject.name == 'Khoa học tự nhiên' ? 'spark' : 'book')}"/></span><strong><c:out value="${subject.name}"/></strong><span>Lớp ${subject.grade_level}</span></a></c:forEach></div><c:if test="${empty subjects}"><p class="empty-state">Danh mục môn học đang được chuẩn bị.</p></c:if></section>
<c:forEach var="grade" items="${grades}"><section class="panel home-panel"><div class="section-heading"><h2 class="section-title">KHÓA HỌC LỚP ${grade}</h2><a href="${pageContext.request.contextPath}/courses?grade=${grade}">Xem tất cả <span aria-hidden="true">→</span></a></div><div class="course-grid"><c:forEach var="course" items="${courses}"><c:if test="${course.grade_level == grade}"><ui:courseCard course="${course}"/></c:if></c:forEach></div></section></c:forEach>
<c:if test="${empty courses}"><section class="panel empty-state"><ui:icon name="book"/><h2>Khóa học đang được chuẩn bị</h2><p>Nội dung mới sẽ xuất hiện khi được bổ sung vào hệ thống.</p></section></c:if>
<section class="panel home-panel"><div class="section-heading"><h2 class="section-title">HỌC TẬP THEO CÁCH CỦA BẠN</h2></div><div class="learning-grid"><a href="${pageContext.request.contextPath}/roadmap"><span class="nav-icon blue"><ui:icon name="route"/></span><h3>Lộ trình rõ ràng</h3><p>Biết mình đã học gì và nên bắt đầu từ đâu.</p><span>Khám phá lộ trình →</span></a><a href="${pageContext.request.contextPath}/quizzes"><span class="nav-icon orange"><ui:icon name="quiz"/></span><h3>Luyện tập chủ động</h3><p>Thử sức với câu hỏi và xem lại kết quả.</p><span>Bắt đầu luyện tập →</span></a><a href="${pageContext.request.contextPath}/forum"><span class="nav-icon green"><ui:icon name="chat"/></span><h3>Cùng nhau hiểu bài</h3><p>Đặt câu hỏi, trao đổi và mở rộng góc nhìn.</p><span>Vào diễn đàn →</span></a></div></section>
<section class="panel home-help"><span class="nav-icon blue"><ui:icon name="search"/></span><div><h2>Tìm đúng bài học, bắt đầu đúng chỗ</h2><p>Tìm kiếm theo môn học, khối lớp hoặc nội dung bạn muốn khám phá.</p></div><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/courses">Tìm khóa học →</a><a href="${pageContext.request.contextPath}/forum">Hỏi cộng đồng</a></section>
</div>