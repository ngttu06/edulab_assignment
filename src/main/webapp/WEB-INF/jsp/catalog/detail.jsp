<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<nav class="breadcrumb-line" aria-label="Đường dẫn"><a href="${pageContext.request.contextPath}/">Trang chủ</a><span aria-hidden="true">/</span><a href="${pageContext.request.contextPath}/courses">Khóa học</a><span aria-hidden="true">/</span><span aria-current="page"><c:out value="${course.subject_name}"/> ${course.grade_level}</span></nav>
<section class="course-intro"><div class="course-cover theme-<c:out value='${course.theme}'/>" aria-hidden="true"><span class="cover-brand">EDULAB</span><span class="cover-subject"><c:out value="${course.subject_name}"/></span><strong class="cover-grade">${course.grade_level}</strong><span class="cover-caption">NẮM VỮNG NỀN TẢNG</span><ui:icon name="book"/></div><div><span class="eyebrow">KHÓA HỌC · LỚP ${course.grade_level}</span><h1><c:out value="${course.title}"/></h1><p class="text-muted"><c:out value="${course.summary}"/></p><p class="course-meta"><span><ui:icon name="book"/>${course.lesson_count} bài học</span><span><ui:icon name="clock"/>${course.duration_minutes} phút</span></p><c:if test="${not empty course.teacher_name}"><p>Giáo viên: <c:out value="${course.teacher_name}"/></p></c:if><a class="btn btn-primary" href="#courseLessons">Khám phá nội dung <span aria-hidden="true">↓</span></a><c:if test="${not empty pageContext.request.userPrincipal}"><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/quizzes?courseId=${course.id}">Luyện tập</a></c:if></div></section>
<c:if test="${pageContext.request.isUserInRole('STUDENT')}"><div class="progress-summary"><strong>Tiến độ của bạn</strong><span>${course.completed_lessons}/${course.lesson_count} bài hoàn thành</span><progress aria-label="Tiến độ khóa học" value="${course.completion_percent}" max="100">${course.completion_percent}%</progress><small>Tiến độ tự đánh dấu, không phải điểm đánh giá.</small></div></c:if>
<section id="courseLessons" class="mt-4"><h2 class="section-title">Nội dung khóa học</h2><p class="text-muted">Học theo từng chủ đề. Một số bài cần hoàn thành bài tiên quyết trước.</p>
    <c:forEach var="step" items="${steps}" varStatus="index"><article class="curriculum-row"><span class="lesson-number">${index.count}</span><div><span class="small text-muted"><c:out value="${step.topic_name}"/></span><h3><c:out value="${step.title}"/></h3><span class="small">${step.duration_minutes} phút<c:if test="${pageContext.request.isUserInRole('STUDENT') and step.progress_status == 'COMPLETED'}"> · Đã hoàn thành</c:if></span></div><c:choose><c:when test="${empty pageContext.request.userPrincipal}"><a class="btn btn-outline-primary btn-sm" href="${pageContext.request.contextPath}/login">Đăng nhập để học</a></c:when><c:when test="${not pageContext.request.isUserInRole('STUDENT') or step.unlocked}"><a class="btn btn-primary btn-sm" href="${pageContext.request.contextPath}/lessons/${step.id}">Mở bài học</a></c:when><c:otherwise><span class="locked-lesson"><ui:icon name="lock"/>Hoàn thành bài #${step.prerequisite_id}<br>Điểm quiz yêu cầu: ${step.required_score}/10</span></c:otherwise></c:choose></article></c:forEach>
    <c:if test="${empty steps}"><div class="empty-state"><ui:icon name="book"/><h3>Nội dung đang được chuẩn bị</h3><p>Khóa học chưa có bài học được xuất bản.</p><a href="${pageContext.request.contextPath}/courses">Khám phá khóa học khác</a></div></c:if>
</section>