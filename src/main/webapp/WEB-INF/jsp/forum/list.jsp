<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<span class="eyebrow">CÙNG NHAU HIỂU BÀI</span><h1 class="h3">Diễn đàn hỏi đáp</h1><p class="text-muted">Một câu hỏi nhỏ có thể mở ra một góc nhìn mới. Không đăng số điện thoại, địa chỉ, mật khẩu hoặc thông tin riêng của bạn và người khác.</p>
<nav class="d-flex flex-wrap gap-2 my-3"><c:forEach var="category" items="${categories}"><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/forum?category=${category.id}"><c:out value="${category.name}"/></a></c:forEach></nav>
<ul class="list-group"><c:forEach var="thread" items="${threads}"><li class="list-group-item"><a href="${pageContext.request.contextPath}/forum/threads/${thread.id}"><c:out value="${thread.title}"/></a> — <c:out value="${thread.author}"/> (<c:out value="${thread.status}"/>)</li></c:forEach></ul>
<c:if test="${empty threads}"><div class="empty-state"><h2>Chưa có thảo luận trong chuyên mục</h2><p>Hãy bắt đầu bằng một câu hỏi về điều bạn đang học.</p></div></c:if>
<c:if test="${not empty categoryId}"><nav class="my-3" aria-label="Phân trang"><c:if test="${page > 0}"><a href="${pageContext.request.contextPath}/forum?category=${categoryId}&amp;page=${page-1}">Trang trước</a> · </c:if><span>Trang ${page+1}</span><c:if test="${threads.size() == 20 and page < 10000}"> · <a href="${pageContext.request.contextPath}/forum?category=${categoryId}&amp;page=${page+1}">Trang sau</a></c:if></nav>
<h2 class="h5">Đặt câu hỏi</h2><p id="forumNotice" role="alert"></p>
<form id="threadForm" data-category="${categoryId}"><label for="threadTitle">Tiêu đề</label><input id="threadTitle" class="form-control mb-2" required maxlength="240"><label for="threadBody">Nội dung (văn bản)</label><textarea id="threadBody" class="form-control mb-3" required maxlength="10000" rows="5"></textarea>
<label for="threadFiles">Ảnh/PDF bài cần giải (tối đa 3 file)</label><input id="threadFiles" type="file" multiple accept="image/jpeg,image/png,image/webp,application/pdf" class="form-control mb-2"><p class="small text-muted">Ảnh 5 MB, PDF 10 MB hoặc thấp hơn theo cấu hình admin. File upload trực tiếp R2; file chờ quét vẫn có thể đính kèm nhưng chưa gửi AI.</p><p id="threadUploadStatus" role="status" aria-live="polite" class="small text-break"></p><button id="threadUploadCancel" type="button" class="btn btn-outline-secondary mb-3" hidden>Hủy upload</button>
<label for="threadLesson">Bài học tham khảo cho AI</label><select id="threadLesson" class="form-select mb-3"><option value="">Không chọn</option><c:forEach var="lesson" items="${lessons}"><option value="${lesson.id()}"><c:out value="${lesson.title()}"/></option></c:forEach></select><div class="form-check mb-3"><input id="threadAi" type="checkbox" class="form-check-input"><label for="threadAi" class="form-check-label">Nhờ AI gợi ý sau khi đăng (gửi câu hỏi và file tới dịch vụ bên thứ ba)</label></div><button type="submit" class="btn btn-primary">Đăng câu hỏi</button></form></c:if>
<script src="${pageContext.request.contextPath}/js/file-upload.js" defer></script>
<script src="${pageContext.request.contextPath}/js/forum.js" defer></script>
