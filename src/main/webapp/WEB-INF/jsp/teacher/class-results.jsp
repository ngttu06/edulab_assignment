<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="class-nav.jspf" %>
<h1 class="h3">${section == 'progress' ? 'Tiến độ bài học' : 'Kết quả quiz'}</h1><p class="text-muted">Số học sinh đang theo học đã hoàn thành. Mở học sinh để xem lịch sử riêng, kể cả khi ngừng tham gia.</p>
<c:if test="${section == 'results'}"><div class="teacher-actions"><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/teacher/classes/${classId}/results.csv">Tải kết quả CSV</a></div><p class="small text-muted">Điểm theo quiz gồm mọi lượt làm của quiz trong lớp, không chỉ lần giao gần nhất. Dấu — nghĩa là chưa có điểm.</p>
<div class="row g-2 mb-3"><div class="col-md-8"><label for="teacherResultSearch" class="visually-hidden">Tìm học sinh hoặc quiz trong bảng điểm</label><input id="teacherResultSearch" type="search" class="form-control" placeholder="Tìm học sinh hoặc quiz"></div><div class="col-md-4"><label for="teacherResultFilter" class="visually-hidden">Lọc theo tình trạng làm quiz</label><select id="teacherResultFilter" class="form-select"><option value="all">Tất cả kết quả</option><option value="missing">Chưa có điểm</option><option value="graded">Đã chấm</option></select></div></div>
<div class="table-responsive teacher-table mb-4" tabindex="0" role="region" aria-label="Bảng điểm theo học sinh và quiz"><table class="table align-middle"><thead><tr><th>Học sinh</th><th>Quiz</th><th>Lượt / đã chấm</th><th>Điểm cao nhất /10</th><th>Chi tiết</th></tr></thead><tbody id="teacherResultRows"><c:forEach var="result" items="${results}"><tr data-title="<c:out value='${result.title}'/>" data-class="<c:out value='${result.full_name}'/>" data-status="${result.graded_count > 0 ? 'graded' : 'missing'}"><td><c:out value="${result.full_name}"/> <c:if test="${not result.active}"><small>(ngừng tham gia)</small></c:if></td><td><c:out value="${result.title}"/></td><td>${result.attempts} / ${result.graded_count}</td><td><c:out value="${result.best_score}" default="—"/></td><td><a href="${pageContext.request.contextPath}/teacher/classes/${classId}/students/${result.id}/results">Xem</a></td></tr></c:forEach></tbody></table></div><c:if test="${empty results}"><p>Chưa có kết quả theo học sinh và quiz.</p></c:if><p id="teacherResultEmpty" class="d-none" role="status">Không có kết quả phù hợp.</p><script src="${pageContext.request.contextPath}/js/teacher-ui.js" defer></script></c:if>
<c:set var="items" value="${section == 'progress' ? roster.lessons : roster.quizzes}"/>
<ul class="list-group mb-4"><c:forEach var="item" items="${items}"><li class="list-group-item"><c:out value="${item.title}"/> · ${item.completed} học sinh hoàn thành</li></c:forEach></ul><c:if test="${empty items}"><p>Chưa có dữ liệu.</p></c:if>
<h2 class="h5">Xem theo học sinh</h2><form class="d-flex flex-wrap gap-2 mb-3"><label for="resultSearch" class="visually-hidden">Tìm học sinh</label><input id="resultSearch" name="search" class="form-control" maxlength="100" value="<c:out value='${roster.search}'/>" placeholder="Tìm học sinh"><button class="btn btn-outline-primary">Tìm</button></form>
<ul class="list-group"><c:forEach var="student" items="${roster.students}"><li class="list-group-item"><a href="${pageContext.request.contextPath}/teacher/classes/${classId}/students/${student.id}/${section}"><c:out value="${student.full_name}"/></a> · ${student.active ? 'Đang theo học' : 'Đã ngừng tham gia'}</li></c:forEach></ul>
<nav aria-label="Phân trang học sinh" class="d-flex gap-3 mt-3"><c:if test="${roster.page > 0}"><c:url var="previous" value="/teacher/classes/${classId}/${section}"><c:param name="search" value="${roster.search}"/><c:param name="page" value="${roster.page - 1}"/></c:url><a href="<c:out value='${previous}'/>">Trang trước</a></c:if><c:if test="${(roster.page + 1) * 25 < roster.total}"><c:url var="next" value="/teacher/classes/${classId}/${section}"><c:param name="search" value="${roster.search}"/><c:param name="page" value="${roster.page + 1}"/></c:url><a href="<c:out value='${next}'/>">Trang sau</a></c:if></nav>