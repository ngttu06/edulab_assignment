<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<aside class="utility-column" aria-label="Tiện ích học tập">
    <section class="study-promo"><span class="promo-label">CÙNG EDULAB</span><h2>Học chủ động.<br>Vững tương lai.</h2><div class="promo-art" aria-hidden="true"><ui:icon name="cap"/><span>Aa</span><span>π</span><span>H₂O</span></div><p>Từ kiến thức nền tảng<br>đến từng bước tiến bộ.</p><a class="btn btn-light" href="${pageContext.request.contextPath}/courses">Khám phá khóa học <span aria-hidden="true">→</span></a></section>
    <a class="btn btn-primary utility-cta" href="${pageContext.request.contextPath}/dashboard"><ui:icon name="chart"/>Vào góc học tập</a>
    <section class="panel utility-panel"><h2>Bạn muốn học gì?</h2><p class="text-muted small">Tìm khóa học phù hợp với mình.</p><form action="${pageContext.request.contextPath}/courses" method="get"><label for="utilityGrade" class="form-label">Khối lớp</label><select id="utilityGrade" name="grade" class="form-select mb-3"><option value="">Tất cả khối lớp</option><c:forEach var="grade" items="${grades}"><option value="${grade}">Lớp ${grade}</option></c:forEach></select><label for="utilitySubject" class="form-label">Môn học</label><select id="utilitySubject" name="subjectId" class="form-select mb-3"><option value="">Tất cả môn học</option><c:forEach var="subject" items="${subjects}"><option value="${subject.id}"><c:out value="${subject.name}"/> · Lớp ${subject.grade_level}</option></c:forEach></select><button class="btn btn-primary w-100" type="submit">Tìm khóa học</button></form></section>
    <section class="panel utility-panel"><h2>Học tập cùng nhau</h2><a class="utility-link" href="${pageContext.request.contextPath}/forum"><span class="nav-icon green"><ui:icon name="chat"/></span><span><strong>Hỏi đáp học tập</strong><small>Chia sẻ câu hỏi, hiểu bài sâu hơn</small></span><span aria-hidden="true">›</span></a><a class="utility-link" href="${pageContext.request.contextPath}/lessons"><span class="nav-icon purple"><ui:icon name="spark"/></span><span><strong>Trợ lý học tập AI</strong><small>Đặt câu hỏi ngay trong bài học</small></span><span aria-hidden="true">›</span></a><p class="small text-muted mb-0">AI có thể trả lời sai hoặc chưa được bật. Không gửi thông tin cá nhân.</p></section>
</aside>