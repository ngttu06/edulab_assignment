<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<a href="${pageContext.request.contextPath}/forum?category=${thread.category_id}">← Chuyên mục</a>
<article class="card my-3"><div class="card-body"><h1 class="h3"><c:out value="${thread.title}"/></h1><p class="small text-muted"><c:out value="${thread.author}"/> · <c:out value="${thread.created_at}"/></p><p class="text-break forum-body"><c:out value="${thread.body}"/></p></div></article>
<p id="forumNotice" role="status"></p>
<c:if test="${pageContext.request.isUserInRole('TEACHER') or pageContext.request.isUserInRole('ADMIN')}"><div class="d-flex gap-2 mb-3"><button class="btn btn-outline-secondary moderateThread" data-id="${thread.id}" data-status="LOCKED">Khóa trả lời</button><button class="btn btn-outline-secondary moderateThread" data-id="${thread.id}" data-status="PUBLISHED">Mở trả lời</button><button class="btn btn-outline-danger moderateThread" data-id="${thread.id}" data-status="HIDDEN">Ẩn thảo luận</button></div></c:if>
<h2 class="h5">Trả lời</h2>
<c:forEach var="post" items="${posts}"><article class="card mb-3"><div class="card-body"><h3 class="h6"><c:out value="${post.author}"/></h3><p class="forum-body text-break"><c:out value="${post.body}"/></p><ul><c:forEach var="file" items="${post.files}"><li><c:choose><c:when test="${file.scan_status == 'CLEAN'}"><a href="${pageContext.request.contextPath}/api/v1/files/${file.id}"><c:out value="${file.original_filename}"/></a></c:when><c:otherwise><c:out value="${file.original_filename}"/> — Đang cách ly / không khả dụng</c:otherwise></c:choose></li></c:forEach></ul></div></article></c:forEach>
<nav class="my-3"><c:if test="${page > 0}"><a href="?page=${page-1}">Trang trước</a> · </c:if>Trang ${page+1}<c:if test="${posts.size() == 20 and page < 10000}"> · <a href="?page=${page+1}">Trang sau</a></c:if></nav>
<c:if test="${thread.status == 'PUBLISHED'}"><form id="postForm" data-id="${thread.id}"><label for="postBody">Nội dung trả lời</label><textarea class="form-control mb-3" id="postBody" required maxlength="10000" rows="4"></textarea><label for="files">Tối đa 3 ảnh (5 MB/tệp) hoặc PDF (10 MB/tệp)</label><input type="file" id="files" class="form-control mb-3" multiple accept="image/jpeg,image/png,image/webp,application/pdf"><button class="btn btn-primary">Đăng trả lời</button></form></c:if>
<script src="${pageContext.request.contextPath}/js/forum.js" defer></script>
