<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="nav.jspf" %>
<div class="teacher-heading"><div><span class="eyebrow">KHÔNG GIAN GIÁO VIÊN</span><h1>Tổng quan giảng dạy</h1><p>Quản lý lớp, chuẩn bị nội dung và theo dõi bài nộp ở một nơi.</p></div><a class="btn btn-primary" href="${pageContext.request.contextPath}/teacher/quizzes/new">Tạo quiz</a></div>
<dl class="teacher-stats"><div><dt>Lớp đang phụ trách</dt><dd>${overview.classes.size()}</dd></div><div><dt>Thành viên đang học</dt><dd>${overview.studentCount}</dd></div><div><dt>Nội dung nháp</dt><dd>${overview.draftCount}</dd></div><div><dt>Bài sắp đến hạn</dt><dd>${overview.upcoming.size()}</dd></div></dl>
<div class="teacher-columns"><section><div class="teacher-section-heading"><h2>Lớp học của bạn</h2><a href="${pageContext.request.contextPath}/teacher/classes">Xem tất cả</a></div><div class="list-group"><c:forEach var="item" items="${overview.classes}"><a class="list-group-item list-group-item-action" href="${pageContext.request.contextPath}/teacher/classes/${item.id}"><strong><c:out value="${item.name}"/></strong><span class="d-block text-muted"><c:out value="${item.academic_year}"/></span></a></c:forEach></div><c:if test="${empty overview.classes}"><div class="empty-state"><h2>Chưa có lớp được phân công</h2><p>Hãy liên hệ quản trị viên để được thêm vào lớp.</p></div></c:if></section>
<section><div class="teacher-section-heading"><h2>Bài cần theo dõi</h2><a href="${pageContext.request.contextPath}/teacher/assignments">Tất cả bài giao</a></div><div class="list-group"><c:forEach var="item" items="${overview.upcoming}"><a class="list-group-item list-group-item-action" href="${pageContext.request.contextPath}/teacher/classes/${item.classroom_id}/assignments/${item.id}"><strong><c:out value="${item.title}"/></strong><span class="d-block"><c:out value="${item.class_name}"/> · ${item.completed_count}/${item.student_count} hoàn thành đúng hạn</span><small class="text-muted">Hạn: <c:out value="${item.due_at}"/> UTC</small></a></c:forEach></div><c:if test="${empty overview.upcoming}"><p>Không có bài đang chờ đến hạn.</p></c:if></section></div>