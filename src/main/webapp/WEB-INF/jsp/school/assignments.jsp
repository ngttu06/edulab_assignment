<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<section class="card my-4"><div class="card-body"><h2 class="h5">Bài được giao (tối đa 100)</h2><c:forEach var="assignment" items="${assignments}"><div class="lesson-item"><div class="flex-grow-1"><strong><c:out value="${assignment.title}"/></strong><p class="small text-muted mb-0"><c:out value="${assignment.class_name}"/> · Hạn: <c:out value="${assignment.due_at}"/> UTC</p></div><c:choose><c:when test="${assignment.completed}"><span class="badge text-bg-success">Đã hoàn thành</span></c:when><c:when test="${assignment.overdue}"><span class="badge text-bg-warning">Quá hạn</span></c:when><c:otherwise><a class="btn btn-outline-primary btn-sm" href="${pageContext.request.contextPath}/quizzes">Cần hoàn thành</a></c:otherwise></c:choose></div></c:forEach><c:if test="${empty assignments}"><p class="text-muted mb-0">Chưa có bài được giao.</p></c:if></div></section>
<section class="card my-4"><div class="card-body"><h2 class="h5">Nhận xét từ giáo viên</h2><c:forEach var="item" items="${feedback}"><div class="lesson-item"><div><strong><c:out value="${item.teacher}"/></strong><p class="forum-body mb-0"><c:out value="${item.body}"/></p><small class="text-muted"><c:out value="${item.created_at}"/> UTC</small></div></div></c:forEach><c:if test="${empty feedback}"><p class="text-muted mb-0">Chưa có nhận xét.</p></c:if></div></section>