# Copy to .env.remote (ignored by Git), chmod 600, and replace secrets locally.
SPRING_PROFILES_ACTIVE=remote
EDULAB_DB_URL='jdbc:mysql://mysql.ngttu.com:3306/edulab_assignment?sslMode=VERIFY_IDENTITY&serverTimezone=UTC&connectTimeout=10000&socketTimeout=30000'
EDULAB_DB_USERNAME=ngttu
EDULAB_DB_PASSWORD=
# Separate Docker deployment job only. Default validates without schema changes.
# Back up/review pending migrations before setting true; application Flyway stays off.
EDULAB_MIGRATE_ON_DEPLOY=false
EDULAB_JWT_SECRET=
EDULAB_AI_PROVIDER=gatecheap
# Generate once: openssl rand -base64 32. Never regenerate at every restart.
EDULAB_AI_ENCRYPTION_KEY=
EDULAB_AI_ALLOWED_HOSTS=gatecheap.vn
EDULAB_STORAGE_ENCRYPTION_KEY=
EDULAB_STORAGE_ALLOWED_HOSTS=c9da795e23235545fa54e8c7ee61d3cf.r2.cloudflarestorage.com
EDULAB_VIDEO_ALLOWED_HOSTS=
EDULAB_PLAYERJS_PATH=/js/vendor/playerjs.js
EDULAB_CLAMAV_HOST=
EDULAB_CLAMAV_PORT=3310
# R2 stays private; configure exact HTTPS origin in bucket CORS and keys through /admin.
# AI stays disabled until an ADMIN saves an encrypted key and enables it in /admin.
# HTTPS is required; do not disable secure cookies on remote.
EDULAB_COOKIE_SECURE=true
EDULAB_DEV_SCAN_BYPASS=false