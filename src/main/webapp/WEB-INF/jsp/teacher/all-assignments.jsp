<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="nav.jspf" %>
<div class="teacher-heading"><div><h1>Bài đã giao</h1><p>Theo dõi bài giao của các lớp được phân công. Số hoàn thành chỉ tính lượt nộp đúng hạn của lần giao này.</p></div><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/teacher/classes">Chọn lớp để giao bài</a></div>
<div class="row g-2 mb-3"><div class="col-md-8"><label for="teacherAssignmentSearch" class="visually-hidden">Tìm bài giao theo quiz hoặc lớp</label><input id="teacherAssignmentSearch" type="search" class="form-control" placeholder="Tìm theo quiz hoặc lớp"></div><div class="col-md-4"><label for="teacherAssignmentFilter" class="visually-hidden">Trạng thái bài giao</label><select id="teacherAssignmentFilter" class="form-select"><option value="all">Tất cả trạng thái</option><option value="live">Đang giao</option><option value="cancelled">Đã hủy</option></select></div></div>
<div class="table-responsive teacher-table" tabindex="0" role="region" aria-label="Bài giao các lớp, cuộn ngang để xem"><table class="table align-middle"><thead><tr><th>Quiz</th><th>Lớp</th><th>Hạn (UTC)</th><th>Hoàn thành đúng hạn</th><th>Trạng thái</th></tr></thead><tbody id="teacherAssignmentRows"><c:forEach var="item" items="${assignments}"><tr data-title="<c:out value='${item.title}'/>" data-class="<c:out value='${item.class_name}'/>" data-status="${empty item.cancelled_at ? 'live' : 'cancelled'}"><td><a href="${pageContext.request.contextPath}/teacher/classes/${item.classroom_id}/assignments/${item.id}"><c:out value="${item.title}"/></a></td><td><c:out value="${item.class_name}"/></td><td><c:out value="${item.due_at}"/></td><td>${item.completed_count}/${item.student_count}</td><td><span class="teacher-badge ${empty item.cancelled_at ? 'is-live' : 'is-muted'}">${empty item.cancelled_at ? 'Đang giao' : 'Đã hủy'}</span></td></tr></c:forEach></tbody></table></div>
<c:if test="${empty assignments}"><div class="empty-state"><h2>Chưa có bài giao</h2><p>Chọn lớp, sau đó giao một quiz đã xuất bản.</p></div></c:if>
<p id="teacherAssignmentEmpty" class="d-none" role="status">Không có bài giao phù hợp.</p><p class="small text-muted">Hiển thị tối đa 200 bài giao gần nhất của các lớp được phân công.</p><script src="${pageContext.request.contextPath}/js/teacher-ui.js" defer></script>