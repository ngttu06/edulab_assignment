<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<a href="${pageContext.request.contextPath}/teacher/classes">← Các lớp</a><h1 class="h3 mt-3">Lớp <c:out value="${roster.classroom.name}"/></h1>
<div class="d-flex gap-2 flex-wrap mb-3"><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/teacher/lessons">+ Soạn bài học</a><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/teacher/quizzes#quizEditor">+ Tạo / nhập quiz</a></div>
<p id="classNotice" role="status" aria-live="polite"></p>
<section class="card mb-4"><div class="card-body"><h2 class="h5">Thêm học sinh vào lớp</h2><p class="small text-muted">Nhập chính xác tên đăng nhập của tài khoản học sinh đã có. Thêm lại sẽ khôi phục tư cách thành viên và giữ lịch sử học tập.</p>
<form id="teacherEnrollForm" data-class="${classId}" class="d-flex gap-2 flex-wrap"><label for="studentUsername" class="visually-hidden">Tên đăng nhập học sinh</label><input id="studentUsername" class="form-control" maxlength="80" required placeholder="Tên đăng nhập học sinh"><button class="btn btn-primary" type="submit">Thêm vào lớp</button></form></div></section>
<form method="get" class="d-flex gap-2 mb-3"><label for="studentSearch" class="visually-hidden">Tìm theo tên hoặc tên đăng nhập</label><input id="studentSearch" name="search" type="search" class="form-control" maxlength="100" value="<c:out value='${roster.search}'/>" placeholder="Tìm học sinh trong lớp"><button class="btn btn-outline-primary flex-shrink-0 text-nowrap">Tìm</button></form>
<p><c:out value="${roster.total}"/> học sinh phù hợp · Trang ${roster.page + 1}</p>
<div class="table-responsive" tabindex="0" role="region" aria-label="Danh sách học sinh, cuộn ngang để xem thao tác"><table class="table align-middle text-nowrap"><thead><tr><th>Học sinh</th><th>Tiến độ bài trong lớp</th><th>Trạng thái</th><th>Quản lý</th></tr></thead><tbody>
<c:forEach var="student" items="${roster.students}"><tr><td><strong><c:out value="${student.full_name}"/></strong><br><small><c:out value="${student.username}"/></small></td><td><c:out value="${student.completion_percent}"/>%</td><td>${student.active ? 'Đang theo học' : 'Đã ngừng tham gia'}</td><td><div class="d-flex flex-wrap gap-2"><c:if test="${student.active}"><a class="btn btn-outline-primary btn-sm" href="${pageContext.request.contextPath}/teacher/classes/${classId}/students/${student.id}">Tiến độ &amp; điểm</a></c:if><button type="button" class="btn btn-outline-secondary btn-sm" data-membership="${student.id}" data-class="${classId}" data-active="${not student.active}">${student.active ? 'Ngừng tham gia' : 'Khôi phục'}</button></div></td></tr></c:forEach>
</tbody></table></div><c:if test="${empty roster.students}"><p>Không có học sinh phù hợp.</p></c:if>
<nav aria-label="Trang học sinh" class="d-flex gap-3"><c:if test="${roster.page > 0}"><c:url var="prev" value="/teacher/classes/${classId}"><c:param name="search" value="${roster.search}"/><c:param name="page" value="${roster.page - 1}"/></c:url><a href="<c:out value='${prev}'/>">← Trang trước</a></c:if><c:if test="${(roster.page + 1) * 25 < roster.total}"><c:url var="next" value="/teacher/classes/${classId}"><c:param name="search" value="${roster.search}"/><c:param name="page" value="${roster.page + 1}"/></c:url><a href="<c:out value='${next}'/>">Trang sau →</a></c:if></nav>
<h2 class="h5 mt-4">Bài học của lớp</h2><ul class="list-group"><c:forEach var="lesson" items="${roster.lessons}"><li class="list-group-item"><a href="${pageContext.request.contextPath}/lessons/${lesson.id}"><c:out value="${lesson.title}"/></a> · ${lesson.completed} học sinh hoàn thành</li></c:forEach></ul><c:if test="${empty roster.lessons}"><p class="text-muted">Chưa có bài học riêng được xuất bản cho lớp.</p></c:if>
<section class="card mt-4"><div class="card-body"><h2 class="h5">Giao quiz cho lớp</h2><p class="small text-muted">Hạn hoàn thành dùng để theo dõi nộp đúng hạn; không thay đổi thời gian hay số lượt của quiz. Kết quả trước thời điểm giao bài không tính hoàn thành bài giao mới.</p><p id="assignmentNotice" role="status"></p><form id="assignmentForm" data-id="${classId}"><label for="assignedQuiz">Quiz đã xuất bản</label><select id="assignedQuiz" class="form-select mb-3"><c:forEach var="quiz" items="${quizzes}"><option value="${quiz.id()}"><c:out value="${quiz.title()}"/></option></c:forEach></select><label for="assignmentDue">Hạn hoàn thành (giờ trên thiết bị)</label><input id="assignmentDue" type="datetime-local" class="form-control mb-3" required><button class="btn btn-primary">Giao bài</button></form></div></section>
<h2 class="h5 mt-4">Bài đã giao</h2><ul class="list-group"><c:forEach var="assignment" items="${assignments}"><li class="list-group-item"><strong><c:out value="${assignment.title}"/></strong><p class="small mb-0">Hoàn thành đúng hạn: ${assignment.completed_count}/${assignment.student_count} · Hạn: <c:out value="${assignment.due_at}"/> UTC</p></li></c:forEach></ul>
<h2 class="h5 mt-4">Kết quả quiz của lớp</h2><p class="small text-muted">Số học sinh đang theo học đã có ít nhất một lượt được chấm, không giới hạn thời hạn giao bài.</p><ul class="list-group"><c:forEach var="quiz" items="${roster.quizzes}"><li class="list-group-item"><c:out value="${quiz.title}"/> · ${quiz.completed} học sinh hoàn thành</li></c:forEach></ul><c:if test="${empty roster.quizzes}"><p class="text-muted">Chưa có quiz được xuất bản cho lớp.</p></c:if>
<script src="${pageContext.request.contextPath}/js/assignments.js" defer></script>
<script src="${pageContext.request.contextPath}/js/teacher-class.js" defer></script>
