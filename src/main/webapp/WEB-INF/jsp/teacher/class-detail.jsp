<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="class-nav.jspf" %>
<div class="teacher-heading"><div><h1>Lớp <c:out value="${classroom.name}"/></h1><p>Năm học <c:out value="${classroom.academic_year}"/> · Theo dõi tiến độ và hỗ trợ học sinh kịp thời.</p></div><c:if test="${empty classroom.archived_at}"><a class="btn btn-primary" href="${pageContext.request.contextPath}/teacher/classes/${classId}/assignments/new">Giao quiz</a></c:if></div>
<dl class="teacher-stats"><div><dt>Học sinh đang học</dt><dd>${summary.studentCount}</dd></div><div><dt>Bài học đã xuất bản</dt><dd>${summary.lessonCount}</dd></div><div><dt>Bài giao gần đây (tối đa 5)</dt><dd>${summary.recent.size()}</dd></div></dl>
<div class="teacher-section-heading"><h2>Bài giao gần nhất</h2><a href="${pageContext.request.contextPath}/teacher/classes/${classId}/assignments">Xem tất cả</a></div><div class="list-group mb-4"><c:forEach var="item" items="${summary.recent}"><a class="list-group-item list-group-item-action" href="${pageContext.request.contextPath}/teacher/classes/${classId}/assignments/${item.id}"><strong><c:out value="${item.title}"/></strong><span class="d-block text-muted">Hạn: <c:out value="${item.due_at}"/> UTC · ${empty item.cancelled_at ? 'Đang giao' : 'Đã hủy'}</span></a></c:forEach></div><c:if test="${empty summary.recent}"><p>Chưa có bài giao nào cho lớp.</p></c:if>
<p id="workspaceNotice" role="status" aria-live="polite"></p>
<c:if test="${pageContext.request.isUserInRole('ADMIN') and empty classroom.archived_at}"><div class="d-flex flex-wrap gap-2"><a class="btn btn-primary" href="${pageContext.request.contextPath}/teacher/classes/${classId}/edit">Chỉnh sửa lớp</a><a class="btn btn-outline-primary" href="${pageContext.request.contextPath}/teacher/classes/${classId}/teachers">Phân công giáo viên</a><button class="btn btn-outline-danger" data-delete="/api/v1/admin/classes/${classId}" data-return="/teacher/classes" data-confirm="Lưu trữ lớp? Lớp ngừng tiếp nhận hoạt động mới; thành viên và lịch sử không bị xóa.">Xóa / lưu trữ lớp</button></div></c:if>
<script src="${pageContext.request.contextPath}/js/teacher-workspace.js" defer></script>