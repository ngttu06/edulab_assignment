<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ include file="nav.jspf" %>
<section class="teacher-overview"><div class="teacher-heading"><div><span class="eyebrow">KHÔNG GIAN GIÁO VIÊN</span><h1>Tổng quan giảng dạy</h1><p>Quản lý lớp, chuẩn bị nội dung và theo dõi bài nộp ở một nơi.</p></div><a class="btn btn-primary" href="${pageContext.request.contextPath}/teacher/quizzes/new">Tạo quiz</a></div>
<div class="stat-grid"><div class="stat-chip"><span class="stat-label">Lớp đang phụ trách</span><strong class="stat-value">${overview.classes.size()}</strong></div><div class="stat-chip"><span class="stat-label">Thành viên đang học</span><strong class="stat-value">${overview.studentCount}</strong></div><div class="stat-chip"><span class="stat-label">Nội dung nháp</span><strong class="stat-value">${overview.draftCount}</strong></div><div class="stat-chip"><span class="stat-label">Bài sắp đến hạn</span><strong class="stat-value">${overview.upcoming.size()}</strong></div></div></section>
<div class="teacher-columns"><section><div class="section-heading"><h2 class="section-title">Lớp học của bạn</h2><a href="${pageContext.request.contextPath}/teacher/classes">Xem tất cả</a></div><div class="list-group"><c:forEach var="item" items="${overview.classes}"><a class="list-group-item list-group-item-action" href="${pageContext.request.contextPath}/teacher/classes/${item.id}"><strong><c:out value="${item.name}"/></strong><span class="d-block text-muted"><c:out value="${item.academic_year}"/></span></a></c:forEach></div><c:if test="${empty overview.classes}"><div class="empty-state"><h3>Chưa có lớp được phân công</h3><p>Hãy liên hệ quản trị viên để được thêm vào lớp.</p></div></c:if></section>
<section><div class="section-heading"><h2 class="section-title">Bài cần theo dõi</h2><a href="${pageContext.request.contextPath}/teacher/assignments">Tất cả bài giao</a></div><div class="list-group"><c:forEach var="item" items="${overview.upcoming}"><a class="list-group-item list-group-item-action" href="${pageContext.request.contextPath}/teacher/classes/${item.classroom_id}/assignments/${item.id}"><strong><c:out value="${item.title}"/></strong><span class="d-block"><c:out value="${item.class_name}"/> · ${item.completed_count}/${item.student_count} hoàn thành đúng hạn</span><small class="text-muted">Hạn: <c:out value="${item.due_at}"/> UTC</small></a></c:forEach></div><c:if test="${empty overview.upcoming}"><p>Không có bài đang chờ đến hạn.</p></c:if></section></div>