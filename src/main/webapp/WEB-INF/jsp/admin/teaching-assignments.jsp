<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" session="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="ui" tagdir="/WEB-INF/tags" %>
<div class="admin-page-heading"><div><span class="admin-eyebrow">CON NGƯỜI & LỚP HỌC</span><h1>Phân công giảng dạy</h1><p>Kết nối đúng giáo viên với đúng lớp học. Một lớp, một người phụ trách chính.</p></div><a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}/admin/teachers">Danh sách giáo viên →</a></div>
<section class="admin-panel"><div class="admin-panel-heading"><div><h2>Tạo / cập nhật phân công</h2><p>Chọn “Phụ trách chính” sẽ thay thế người phụ trách chính hiện tại; người cũ vẫn là giáo viên giảng dạy.</p></div></div>
<form class="admin-relationship-form" data-relationship="teacher"><ui:adminReference name="classId" label="Lớp học" resource="classes" required="true"/><ui:adminReference name="teacherId" label="Giáo viên" resource="teachers" required="true"/><div><label class="form-label" for="homeroom">Vai trò</label><select id="homeroom" name="homeroom" class="form-select"><option value="false">Giáo viên giảng dạy</option><option value="true">Phụ trách chính / chủ nhiệm</option></select></div><button class="btn btn-primary">Lưu phân công</button></form></section>
<section class="admin-panel admin-section"><form class="admin-filter" method="get"><div class="admin-search"><ui:icon name="search"/><label class="visually-hidden" for="assignmentSearch">Tìm lớp, giáo viên hoặc năm học</label><input id="assignmentSearch" name="search" value="<c:out value='${search}'/>" maxlength="160" placeholder="Tìm lớp, giáo viên hoặc năm học…"></div><button class="btn btn-outline-secondary">Tìm kiếm</button></form>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Lớp học</th><th>Giáo viên</th><th>Năm học</th><th>Vai trò</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="item" items="${listing.items()}"><tr><td><a class="admin-cell-title" href="${pageContext.request.contextPath}/admin/classes/${item.class_id}"><c:out value="${item.class_name}"/></a></td><td><a href="${pageContext.request.contextPath}/admin/teachers/${item.teacher_id}"><c:out value="${item.full_name}"/></a><small><c:out value="${item.username}"/></small></td><td><c:out value="${item.academic_year}"/></td><td><span class="admin-badge ${item.is_homeroom_teacher ? 'success' : ''}">${item.is_homeroom_teacher ? 'Phụ trách chính' : 'Giảng dạy'}</span></td><td><c:choose><c:when test="${empty item.archived_at}"><button class="btn btn-sm btn-outline-danger" data-remove-teacher="${item.teacher_id}" data-class-id="${item.class_id}">Thu hồi</button></c:when><c:otherwise>Đã lưu trữ lớp</c:otherwise></c:choose></td></tr></c:forEach><c:if test="${empty listing.items()}"><tr><td colspan="5" class="admin-empty">Chưa có phân công phù hợp. Tạo phân công bằng biểu mẫu phía trên.</td></tr></c:if></tbody></table></div><jsp:include page="/WEB-INF/jsp/admin/pagination.jsp"/></section>