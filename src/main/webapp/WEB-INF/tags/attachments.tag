<%@ tag body-content="empty" pageEncoding="UTF-8" %>
<%@ attribute name="files" required="false" type="java.util.List" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div class="feed-attachments"><c:forEach var="file" items="${files}"><div class="feed-attachment"><c:choose><c:when test="${file.scan_status == 'CLEAN'}"><c:if test="${file.content_type == 'image/jpeg' or file.content_type == 'image/png' or file.content_type == 'image/webp'}"><a class="feed-image-link" href="${pageContext.request.contextPath}/api/v1/files/${file.id}"><img src="${pageContext.request.contextPath}/api/v1/files/${file.id}/image" alt="<c:out value='${file.original_filename}'/>" loading="lazy" decoding="async"></a></c:if><a class="feed-file-link" href="${pageContext.request.contextPath}/api/v1/files/${file.id}"><c:out value="${file.original_filename}"/> ↓</a></c:when><c:otherwise><span class="feed-file-link"><c:out value="${file.original_filename}"/> — Đang cách ly / không khả dụng</span></c:otherwise></c:choose></div></c:forEach></div>